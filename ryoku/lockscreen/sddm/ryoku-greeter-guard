#!/usr/bin/env bash
#
# ryoku-greeter-guard: bring the login screen back when SDDM has lost it.
#
# SDDM 0.21 cannot tell a Wayland greeter that died from one that logged
# somebody in. sddm-helper-start-wayland exits 0 whenever the greeter client
# finishes or the compositor dies, the daemon reads that as HELPER_SUCCESS and
# starts nothing, and the machine sits on an empty VT with a blinking cursor:
# no greeter, no session, no way to log in short of a text console. The greeter
# wrapper (ryoku-greeter) restarts a compositor that dies before the greeter
# connects; a greeter client that dies after connecting is beyond its reach, so
# this guard watches the daemon from outside.
#
# The rule: while the sddm daemon runs with no sddm-helper at all, neither a
# greeter helper (--greeter) nor a session helper, for longer than the grace
# period, restart the display manager. Every SDDM session, greeter or user, runs
# under an sddm-helper, so "no helper" means nobody is logged in and nothing is
# being shown; a restart cannot cost a user their session. Restarts are capped
# per boot so a greeter that cannot run leaves a readable trail in the system
# log instead of a loop.
#
# Runs as root under systemd (ryoku-greeter-guard.service) and runit
# (void/init/system/ryoku-greeter-guard). `--once` evaluates one round and
# exits: 0 nothing to do, 3 a restart was issued; the loop is the service.
set -u

interval=${RYOKU_GREETER_GUARD_INTERVAL:-5}
grace=${RYOKU_GREETER_GUARD_GRACE:-20}
limit=${RYOKU_GREETER_GUARD_LIMIT:-3}
state=${RYOKU_GREETER_GUARD_STATE:-/run/ryoku/greeter-guard}
proc=${RYOKU_GREETER_GUARD_PROC:-/proc}
host=${RYOKU_GREETER_GUARD_HOST:-ryoku-host}

log() { logger -t ryoku-greeter-guard -p "daemon.$1" -- "$2" 2>/dev/null || echo "ryoku-greeter-guard: $2" >&2; }

# comm names come from the kernel, so no command-line parsing can be fooled by
# an argument that merely mentions a process name. A process can vanish between
# the directory listing and the read; stderr is silenced before the redirect so
# that race leaves no noise.
comm_of() { tr -d '\n' 2>/dev/null <"$1/comm"; }

daemon_running() {
  local dir
  for dir in "$proc"/[0-9]*; do
    [ "$(comm_of "$dir")" = sddm ] && return 0
  done
  return 1
}

# Every greeter or user session SDDM starts runs under an sddm-helper.
helper_running() {
  local dir
  for dir in "$proc"/[0-9]*; do
    [ "$(comm_of "$dir")" = sddm-helper ] && return 0
  done
  return 1
}

restart_count() { cat "$state/restarts" 2>/dev/null || echo 0; }

check_once() {
  local now since count
  mkdir -p "$state"
  if ! daemon_running || helper_running; then
    rm -f "$state/missing-since"
    return 0
  fi
  now=$(date +%s)
  if [ ! -f "$state/missing-since" ]; then
    printf '%s\n' "$now" >"$state/missing-since"
    return 0
  fi
  since=$(cat "$state/missing-since")
  [ $(( now - since )) -ge "$grace" ] || return 0
  count=$(restart_count)
  if [ "$count" -ge "$limit" ]; then
    if [ ! -f "$state/gave-up" ]; then
      : >"$state/gave-up"
      log err "SDDM still shows no login screen after $limit restarts this boot; leaving it. Read the ryoku-greeter lines in the system log and /var/lib/sddm/.local/share/sddm-helper-start-wayland/sddm.log for why the greeter dies, or log in on a text console and run ryoku doctor."
    fi
    return 0
  fi
  count=$(( count + 1 ))
  printf '%s\n' "$count" >"$state/restarts"
  rm -f "$state/missing-since"
  log err "SDDM has shown no login screen and runs no session for ${grace}s; restarting the display manager ($count of $limit this boot)"
  "$host" svc --system restart sddm
  return 3
}

case "${1:-}" in
  --once)
    check_once
    ;;
  '')
    while :; do
      check_once
      sleep "$interval"
    done
    ;;
  *)
    echo "usage: ryoku-greeter-guard [--once]" >&2
    exit 2
    ;;
esac
