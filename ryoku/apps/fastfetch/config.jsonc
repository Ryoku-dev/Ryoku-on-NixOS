// Ryoku Nix
// Zero-inspired default: minimal system identity with a small Ryoku NixOS mark.
// ryoku:recolor keys=primary title=foreground output=onSurface
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/ryoku-nixos.png",
    "width": 20,
    "height": 10,
    "padding": {
      "top": 1,
      "right": 3,
      "left": 1
    }
  },

  "display": {
    "color": {
      "keys": "#e2342a",
      "title": "#f3ede1",
      "output": "#cec7c4"
    },
    "key": {
      "width": 7
    },
    "separator": " "
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#1;title}ryoku // nixos{#}"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "wm",
      "key": "desktop"
    },
    { "type": "command", "key": "shell", "text": "basename \"${SHELL:-unknown}\"" },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "uptime",
      "key": "up"
    }
  ]
}
