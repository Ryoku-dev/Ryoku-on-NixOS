#!/bin/sh
set -u

BIN=${RYOKU_AI_USAGE_BIN_DIR:-$(dirname "$0")}
# A service starts with a minimal PATH, so also look where the tools usually
# land: beside the collectors, and the per-user install locations.
PATH="${PATH:-}:$BIN:$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.local/share/mise/shims:$HOME/.opencode/bin"
export PATH

CODEX_DATA=${CODEX_HOME:-"$HOME/.codex"}
OPENCODE_DATA_HOME=${XDG_DATA_HOME:-"$HOME/.local/share"}
OPENCODE_DATA=${OPENCODE_DATA_DIR:-"$OPENCODE_DATA_HOME/opencode"}

wants_claude() {
	command -v claude >/dev/null 2>&1 || [ -f "$HOME/.claude/.credentials.json" ]
}

wants_codex() {
	command -v codex >/dev/null 2>&1 || [ -d "$CODEX_DATA" ]
}

wants_opencode() {
	command -v opencode >/dev/null 2>&1 ||
		[ -d "$OPENCODE_DATA/storage" ] ||
		[ -f "$OPENCODE_DATA/opencode.db" ]
}

available() {
	wants_claude || wants_codex || wants_opencode
}

if [ "${1:-}" = --available ]; then
	available
	exit
fi

[ $# -eq 0 ] || {
	printf 'usage: ryoku-ai-usage [--available]\n' >&2
	exit 2
}

if wants_claude; then
	"$BIN/claude-usage" || true
fi
if wants_codex; then
	"$BIN/codex-usage" || true
fi
if wants_opencode; then
	"$BIN/opencode-usage" || true
fi
