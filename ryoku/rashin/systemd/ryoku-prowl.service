[Unit]
Description=Ryoku Prowl: model gateway and code intelligence for Rashin
BindsTo=ryoku-rashin.service
After=ryoku-rashin.service
StartLimitIntervalSec=0

[Service]
ExecStartPre=-/bin/sh -c 'exec /usr/bin/prowl gateway down --port "$${RYOKU_PROWL_PORT:-8788}"'
ExecStart=/bin/sh -c 'exec /usr/bin/prowl gateway serve --port "$${RYOKU_PROWL_PORT:-8788}"'
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
