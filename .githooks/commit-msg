#!/usr/bin/env bash

# Ryoku commit-msg hook.
# Enforces a short conventional subject (with optional legacy impact prefix),
# validates the release-note trailer consumed by the release tooling, and keeps
# an Urgent: trailer well formed.

set -euo pipefail

msg_file="$1"
subject=$(sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; p; q' "$msg_file")

fail() {
  echo "" >&2
  echo "commit-msg hook rejected this commit:" >&2
  echo "  $1" >&2
  echo "" >&2
  echo "fix the message and re-run git commit." >&2
  exit 1
}

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) ;;
  *)
    pattern='^(\[(global|installation|system|ryoku|docs|test|tooling|release)\][[:space:]]+)?(feat|fix|docs|refactor|perf|test|build|ci|chore|release)(\([^)]+\))?(!)?:[[:space:]]+[^[:space:]].*$'
    if [[ ! "$subject" =~ $pattern ]]; then
      fail "use 'type(scope): summary' (legacy [area] prefix is optional)."
    fi

    if ((${#subject} > 72)); then
      fail "subject is ${#subject} chars; keep it to 72 or fewer."
    fi

    if [[ "$subject" == *. ]]; then
      fail "subject must not end with a period."
    fi
    ;;
esac

while IFS= read -r line; do
  if [[ "$line" =~ ^[[:space:]]*[Nn]ote: ]]; then
    if [[ ! "$line" =~ ^[[:space:]]*[Nn]ote:[[:space:]]*([Nn]ew|[Ff]ixed|[Rr]emoved):[[:space:]]*[^[:space:]] ]]; then
      fail "malformed Note: trailer. Use 'Note: New|Fixed|Removed: plain description'."
    fi
  fi
done < "$msg_file"

# An Urgent: trailer asks every NixOS box without the commit to update now
# (docs/nixos.md, "Urgent updates"). `ryoku status` reads it from the last
# paragraph of a commit on the followed branch's first-parent line; only a
# maintainer sets one, and the Urgent trailer workflow refuses it in a PR.
trailers=$(sed '/^#/d' "$msg_file" | awk 'BEGIN { RS = "" } { last = $0 } END { if (NR > 1) print last }')
urgent=0
while IFS= read -r line; do
  [[ ${line,,} == urgent:* ]] || continue
  urgent=$((urgent + 1))
  if ! grep -qxF -- "$line" <<<"$trailers"; then
    fail "Urgent: is a trailer: put it in the last paragraph, below the body, with Note: and the others."
  fi
  reason="${line#*:}"
  reason="${reason#"${reason%%[![:space:]]*}"}"
  if [[ -z $reason ]]; then
    fail "malformed Urgent: trailer. Use 'Urgent: why every box should update now'."
  fi
  if ((${#reason} > 160)); then
    fail "the Urgent: reason is ${#reason} chars; keep it to one sentence of 160 or fewer, it is the alert's text."
  fi
done < "$msg_file"
if ((urgent > 1)); then
  fail "one Urgent: trailer per commit."
fi

exit 0
