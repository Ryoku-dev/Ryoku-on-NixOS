#!/usr/bin/env bash
# Retire Ryotunes installs that would shadow Hyperion's.
#
# usage: ryoku-hyperion-retire-ryotunes RYOTUNES_PACKAGE BACKUP_DIR
#
# Older setups exposed Ryotunes through ~/.local/bin links into a RyoMarket
# flake-app profile or a manual preview, user desktop entries and user units.
# ~/.local/bin precedes the system profile on PATH, so those copies won and
# their daemon owned $XDG_RUNTIME_DIR/ryotunes/ryotunesd.sock.
#
# Only exposure Ryoku itself created is moved (never deleted) into BACKUP_DIR.
# Anything unrecognised is reported and left alone. User data
# (~/.local/share/dev.ryoku.ryotunes, ~/.config/ryotunes), the RyoMarket
# profile itself and unrelated ryotunes-* tools are never touched.
set -euo pipefail

package="${1:?ryotunes package path required}"
backup="${2:?backup directory required}/ryotunes-legacy"

bin_dir="$HOME/.local/bin"
apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
units_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
proc_root="${RYOKU_PROC_ROOT:-/proc}"

moved=0

retire() {
    mkdir -p "$backup"
    mv -- "$1" "$backup/"
    printf 'ryotunes: retired legacy %s (kept in %s)\n' "$1" "$backup"
    moved=1
}

# A link Ryoku's legacy installs made: into a RyoMarket flake-app profile, the
# manual Hyperion preview or any store path that is not this generation's.
legacy_link() {
    local target
    [ -L "$1" ] || return 1
    target="$(readlink -- "$1")"
    case "$target" in
        "$package"/*) return 1 ;;
        */ryomarket/flake-apps/ryotunes/*|*/ryoku-hyperion/ryotunes-preview/*) return 0 ;;
        /nix/store/*ryotunes*) return 0 ;;
    esac
    return 1
}

for name in ryotunes ryotunes-qml ryotunesd ryotunes-cli ryotunes-sync ryotunes-diagnostics ryotunes-hyperion; do
    path="$bin_dir/$name"
    [ -e "$path" ] || [ -L "$path" ] || continue
    if legacy_link "$path"; then
        retire "$path"
    elif [ -f "$path" ] && ! [ -L "$path" ] &&
         grep -Eq 'ryomarket/flake-apps/ryotunes|ryotunes-hyperion' "$path"; then
        # The channel dispatcher script written for the Hyperion preview.
        retire "$path"
    else
        printf 'ryotunes: warning: %s is not a Ryoku install and still shadows Hyperion Ryotunes on PATH\n' "$path" >&2
    fi
done

for name in dev.ryoku.ryomarket.ryotunes.desktop ryotunes-hyperion.desktop ryotunes.desktop; do
    path="$apps_dir/$name"
    [ -e "$path" ] || [ -L "$path" ] || continue
    if legacy_link "$path"; then
        retire "$path"
    elif [ -f "$path" ] && ! [ -L "$path" ] &&
         grep -Eq '^Exec=.*(ryotunes-hyperion|flake-apps/ryotunes|ryomarket)' "$path"; then
        retire "$path"
    elif [ "$name" != ryotunes.desktop ]; then
        printf 'ryotunes: warning: left unrecognised %s\n' "$path" >&2
    fi
done

# User units override the NixOS-provided ryotunesd.socket/.service.
for name in ryotunesd.service ryotunesd.socket sockets.target.wants/ryotunesd.socket; do
    path="$units_dir/$name"
    if [ -e "$path" ] || [ -L "$path" ]; then
        retire "$path"
    fi
done
dropins="$units_dir/ryotunesd.service.d"
if [ -d "$dropins" ] && [ -z "$(ls -A "$dropins")" ]; then
    rmdir -- "$dropins"
elif [ -d "$dropins" ]; then
    printf 'ryotunes: warning: %s overrides the Ryotunes daemon unit\n' "$dropins" >&2
fi

# Stop daemons and clients that are not this generation's, so the
# socket-activated daemon owns the session socket again.
stopped=0
for proc in "$proc_root"/[0-9]*; do
    exe="$(readlink "$proc/exe" 2>/dev/null)" || continue
    cmdline="$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null)" || continue
    case "$exe" in
        "$package"/*) continue ;;
    esac
    case "$exe:$cmdline" in
        *ryotunes-soloist*) continue ;;
        */ryotunesd:*|*/.ryotunesd-wrapped:*|*:*share/ryotunes/client*)
            kill -TERM "${proc##*/}" 2>/dev/null && stopped=1
            ;;
    esac
done

if [ "$moved" -eq 1 ]; then
    systemctl --user daemon-reload 2>/dev/null || true
fi
if [ "$stopped" -eq 1 ]; then
    # A legacy daemon replaced the socket file; rebind it.
    systemctl --user restart ryotunesd.socket 2>/dev/null || true
else
    systemctl --user start ryotunesd.socket 2>/dev/null || true
fi
