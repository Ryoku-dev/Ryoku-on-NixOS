#!/usr/bin/env bash
set -euo pipefail

# Paths maintained by the NixOS port. Upstream changes below these paths never
# enter a sync commit.
FORK_OWNED_PATHS=(
  nix
  flake.nix
  flake.lock
  .github
  README.md
  docs/nixos.md
  website
)

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=nix/sync/lib-markers.sh
source "$script_dir/lib-markers.sh"
upstream_wins_file="$script_dir/upstream-wins"
[[ -f $upstream_wins_file ]] || {
  printf 'ryoku-sync: missing %s\n' "$upstream_wins_file" >&2
  exit 1
}

lane=""
dry_run=0
upstream="https://github.com/Ryoku-dev/ryoku.git"
fork_remote="origin"
upstream_repo="${RYOKU_UPSTREAM_REPO:-Ryoku-dev/ryoku}"
gh_command="${RYOKU_SYNC_GH:-gh}"
repository="${GITHUB_REPOSITORY:-Ryoku-dev/Ryoku-on-NixOS}"
body_cap=${RYOKU_SYNC_BODY_CAP:-60000}

usage() {
  cat <<'USAGE'
Usage: nix/sync/ryoku-sync --lane unstable|stable [options]

Options:
  --lane LANE          Sync unstable or stable
  --dry-run            Compute and print the result without pushing or changing GitHub
  --upstream URL       Ryoku git URL or local repository path
  --fork-remote NAME   Remote for Ryoku-on-NixOS (default: origin)
  -h, --help           Show this help
USAGE
}

die() {
  printf 'ryoku-sync: %s\n' "$*" >&2
  exit 1
}

while (($#)); do
  case "$1" in
    --lane)
      (($# >= 2)) || die "--lane needs a value"
      lane=$2
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --upstream)
      (($# >= 2)) || die "--upstream needs a value"
      upstream=$2
      shift 2
      ;;
    --fork-remote)
      (($# >= 2)) || die "--fork-remote needs a value"
      fork_remote=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ $lane == unstable || $lane == stable ]] || die "--lane must be unstable or stable"
[[ $body_cap =~ ^[0-9]+$ ]] && ((body_cap > 0)) \
  || die "RYOKU_SYNC_BODY_CAP must be a positive integer"
git rev-parse --git-dir >/dev/null 2>&1 || die "run this from a Ryoku-on-NixOS checkout"

if [[ $lane == unstable ]]; then
  base_branch=unstable-dev
else
  base_branch=main
fi
upstream_ref="refs/ryoku-sync/upstream/unstable-dev"
upstream_tags="refs/ryoku-sync/tags"
upstream_main_ref="refs/ryoku-sync/upstream/main"
fork_base_ref="refs/remotes/$fork_remote/$base_branch"
fork_unstable_ref="refs/remotes/$fork_remote/unstable-dev"
sync_ref="refs/remotes/$fork_remote/sync/$lane"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/ryoku-sync.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT

fetch_fork_branch() {
  local branch=$1
  local destination="refs/remotes/$fork_remote/$branch"
  git fetch --quiet --no-tags "$fork_remote" "+refs/heads/$branch:$destination"
}

fetch_optional_fork_branch() {
  local branch=$1
  local destination="refs/remotes/$fork_remote/$branch"
  if git ls-remote --exit-code --heads "$fork_remote" "$branch" >/dev/null 2>&1; then
    git fetch --quiet --no-tags "$fork_remote" "+refs/heads/$branch:$destination"
    return 0
  fi
  git update-ref -d "$destination" 2>/dev/null || true
  return 1
}

fetch_upstream_branch() {
  local source_ref="refs/heads/unstable-dev"
  if ! git ls-remote --exit-code "$upstream" "$source_ref" >/dev/null 2>&1; then
    source_ref="refs/remotes/origin/unstable-dev"
  fi
  git ls-remote --exit-code "$upstream" "$source_ref" >/dev/null 2>&1 \
    || die "upstream has no unstable-dev branch or origin/unstable-dev remote ref"
  git fetch --quiet --no-tags "$upstream" "+$source_ref:$upstream_ref"
}

# The stable lane needs upstream main and the tags on it.
fetch_upstream_main_and_tags() {
  local source_ref="refs/heads/main"
  if ! git ls-remote --exit-code "$upstream" "$source_ref" >/dev/null 2>&1; then
    source_ref="refs/remotes/origin/main"
  fi
  git ls-remote --exit-code "$upstream" "$source_ref" >/dev/null 2>&1 \
    || die "upstream has no main branch or origin/main remote ref"
  git fetch --quiet --no-tags "$upstream" \
    "+$source_ref:$upstream_main_ref" "+refs/tags/v*:$upstream_tags/v*"
}

read_sync_commit() {
  local commit=$1
  local value
  if value=$(git show "$commit:nix/sync/ryoku-commit" 2>/dev/null); then
    value=${value%%$'\n'*}
    [[ $value =~ ^[0-9a-f]{40}$ ]] || die "invalid nix/sync/ryoku-commit at $commit"
    printf '%s\n' "$value"
    return
  fi
  if value=$(git show "$commit:nix/sync/upstream.json" 2>/dev/null); then
    value=$(jq -er '.upstream.commit' <<<"$value") \
      || die "invalid nix/sync/upstream.json at $commit"
    [[ $value =~ ^[0-9a-f]{40}$ ]] || die "invalid upstream commit at $commit"
    printf '%s\n' "$value"
    return
  fi
  die "no recorded upstream commit at $commit"
}

# The newest upstream unstable-dev commit whose Testing gate passed. This is
# the commit channels/testing/checked.json names, read from the gate's own runs
# because repo.ryoku.dev refuses requests from GitHub's runners.
gh_passed_commit() {
  "$gh_command" api \
    "repos/$upstream_repo/actions/workflows/testing-gate.yml/runs?branch=unstable-dev&status=success&per_page=1" \
    --jq '.workflow_runs[0].head_sha // empty'
}

upstream_target_unstable() {
  local passed tip sha author subject
  passed=$(gh_passed_commit) || die "could not read the upstream Testing gate runs"
  [[ $passed =~ ^[0-9a-f]{40}$ ]] || die "no passed Testing gate run on upstream unstable-dev"
  git cat-file -e "$passed^{commit}" 2>/dev/null || die "passed commit is not in upstream unstable-dev history"

  tip=$(git rev-parse "$upstream_ref^{commit}")
  if ! git merge-base --is-ancestor "$passed" "$tip"; then
    printf '%s\n' "$passed"
    return
  fi
  while IFS= read -r sha; do
    [[ -n $sha ]] || continue
    author=$(git show -s --format=%an "$sha")
    subject=$(git show -s --format=%s "$sha")
    if [[ $author != 'github-actions[bot]' || $subject != release:\ bump\ unstable\ to\ * ]]; then
      printf '%s\n' "$passed"
      return
    fi
  done < <(git rev-list "$passed..$tip")
  printf '%s\n' "$tip"
}

# The release Stable Release last tagged on upstream main. Main only moves by a
# maintainer's fast-forward plus that workflow, so this is the stable lane;
# tags off main (old hotfix or test tags) never qualify.
upstream_target_stable() {
  local tag_ref
  tag_ref=$(git for-each-ref --merged="$upstream_main_ref" --sort=-creatordate \
    --count=1 --format='%(refname)' "$upstream_tags/v[0-9]*")
  [[ -n $tag_ref ]] || die "upstream main has no v* release tag"
  git rev-parse "$tag_ref^{commit}"
}

find_stable_fork_state() {
  local target=$1 commit recorded
  while IFS= read -r commit; do
    if ! recorded=$(read_sync_commit "$commit" 2>/dev/null); then
      continue
    fi
    if git cat-file -e "$recorded^{commit}" 2>/dev/null \
      && git merge-base --is-ancestor "$recorded" "$target"; then
      printf '%s %s\n' "$commit" "$recorded"
      return 0
    fi
  done < <(git rev-list --first-parent "$fork_unstable_ref")
  return 1
}


extract_sync_marker() {
  local body=$1 line value marker=""
  local prefix='<!-- ryoku-sync-head: ' suffix=' -->'
  while IFS= read -r line; do
    if [[ $line == "$prefix"*"$suffix" ]]; then
      value=${line#"$prefix"}
      value=${value%"$suffix"}
      [[ $value =~ ^[0-9a-f]{40}$ ]] && marker=$value
    fi
  done <<<"$body"
  printf '%s\n' "$marker"
}

sync_branch_is_reusable() {
  local branch_head body marker
  branch_head=$(git rev-parse "$sync_ref")
  open_pr_number=$(gh_find_pr)
  # Without an open PR nobody is working on the branch: it was merged or the
  # PR was closed, so the next target may replace it.
  [[ -n $open_pr_number ]] || return 0
  body=$(gh_get_pr_body "$open_pr_number")
  marker=$(extract_sync_marker "$body")
  [[ $marker == "$branch_head" ]]
}

path_exists() {
  local tree=$1 path=$2
  git cat-file -e "$tree:$path" 2>/dev/null
}

is_fork_owned() {
  local path=$1 owned
  for owned in "${FORK_OWNED_PATHS[@]}"; do
    if [[ $path == "$owned" || $path == "$owned/"* ]]; then
      return 0
    fi
  done
  return 1
}
is_upstream_wins() {
  local path=$1 rule prefix
  local result=1
  while IFS= read -r rule || [[ -n $rule ]]; do
    rule=${rule%$'\r'}
    rule=${rule#"${rule%%[![:space:]]*}"}
    rule=${rule%"${rule##*[![:space:]]}"}
    [[ -n $rule && $rule != \#* ]] || continue

    local include=1
    if [[ $rule == '!'* ]]; then
      include=0
      rule=${rule#!}
    fi

    if [[ $rule == */ ]]; then
      prefix=${rule%/}
      if [[ $path != "$prefix" && $path != "$prefix/"* ]]; then
        continue
      fi
    elif [[ $rule != */* ]]; then
      [[ ${path##*/} == "$rule" ]] || continue
    else
      [[ $path == "$rule" ]] || continue
    fi

    if ((include)); then
      result=0
    else
      result=1
    fi
  done <"$upstream_wins_file"
  return "$result"
}
declare -A STALE_COPY_SET=()
stale_copies=()

collect_stale_copies() {
  local base=$1 ours_tree=$2 path blob object_type metadata history_path
  local old_blob new_blob candidate offset
  local -a changed_paths candidate_paths chunk
  local -A candidate_blobs=() seen=()

  mapfile -d '' -t changed_paths \
    < <(git diff-tree --no-commit-id --name-only -r -z "$base" "$ours_tree")
  for path in "${changed_paths[@]}"; do
    is_fork_owned "$path" && continue
    path_exists "$ours_tree" "$path" || continue
    # A file upstream had already dropped by the base is one the port chose to
    # keep, even when its bytes match an old upstream version.
    path_exists "$base" "$path" || continue
    blob=$(git rev-parse "$ours_tree:$path")
    object_type=$(git cat-file -t "$blob")
    [[ $object_type == blob ]] || continue
    candidate_paths+=("$path")
    candidate_blobs["$path"]=$blob
  done

  for ((offset = 0; offset < ${#candidate_paths[@]}; offset += 128)); do
    chunk=("${candidate_paths[@]:offset:128}")
    while IFS= read -r -d '' metadata && IFS= read -r -d '' history_path; do
      metadata=${metadata#:}
      read -r _ _ old_blob new_blob _ <<<"$metadata"
      candidate=${candidate_blobs["$history_path"]-}
      [[ -n $candidate ]] || continue
      if [[ $candidate == "$old_blob" || $candidate == "$new_blob" ]]; then
        seen["$history_path"]=1
      fi
    done < <(git log --raw -z --no-abbrev --no-renames --format= \
      "$base" -- "${chunk[@]}")
  done

  STALE_COPY_SET=()
  stale_copies=()
  for path in "${candidate_paths[@]}"; do
    [[ -n ${seen["$path"]-} ]] || continue
    STALE_COPY_SET["$path"]=1
    stale_copies+=("$path")
  done
}



under_removed_directory() {
  local path=$1 base=$2 ours=$3 prefix="" component depth=0
  local directory=${path%/*}
  [[ $directory != "$path" ]] || return 1
  IFS='/' read -r -a components <<<"$directory"
  for component in "${components[@]}"; do
    ((depth += 1))
    ((depth <= 2)) || break
    if [[ -z $prefix ]]; then
      prefix=$component
    else
      prefix="$prefix/$component"
    fi
    if path_exists "$base" "$prefix" && ! path_exists "$ours" "$prefix"; then
      return 0
    fi
  done
  return 1
}

remove_index_paths() {
  local index=$1
  shift
  GIT_INDEX_FILE=$index git rm -r -q -f --cached --ignore-unmatch -- "$@"
}

restore_index_paths() {
  local index=$1 source=$2
  shift 2
  git ls-tree -r -z "$source" -- "$@" \
    | GIT_INDEX_FILE=$index git update-index -z --index-info
}

set_index_file() {
  local index=$1 source=$2 path=$3
  remove_index_paths "$index" "$path"
  restore_index_paths "$index" "$source" "$path"
}

collect_notes() {
  local range=$1 commit line
  notes=()
  while IFS= read -r commit; do
    while IFS= read -r line; do
      [[ $line == Note:* ]] && notes+=("${line#Note: }")
    done < <(git show -s --format=%B "$commit" | git interpret-trailers --parse)
  done < <(git rev-list --reverse "$range")
}

relabel_conflict_file() {
  local index=$1 path=$2 entry mode blob stage line read_status
  local source="$tmp_dir/conflict-source" relabelled="$tmp_dir/conflict-relabelled"

  entry=$(GIT_INDEX_FILE=$index git ls-files --stage -- "$path")
  read -r mode blob stage _ <<<"$entry"
  [[ $stage == 0 && -n $mode && -n $blob ]] \
    || die "could not read merged conflict file: $path"
  git cat-file blob "$blob" >"$source"
  : >"$relabelled"
  while true; do
    if IFS= read -r line <&3; then
      read_status=0
    else
      read_status=$?
    fi
    ((read_status == 0)) || [[ -n $line ]] || break
    case "$line" in
      '<<<<<<< '*) line="<<<<<<< port ($base_branch)" ;;
      '||||||| '*) line="||||||| last sync (${merge_base:0:7})" ;;
      '>>>>>>> '*) line=">>>>>>> upstream Ryoku $version (${target:0:7})" ;;
    esac
    if ((read_status == 0)); then
      printf '%s\n' "$line" >>"$relabelled"
    else
      printf '%s' "$line" >>"$relabelled"
      break
    fi
  done 3<"$source"
  blob=$(git hash-object -w "$relabelled")
  GIT_INDEX_FILE=$index git update-index --add --cacheinfo "$mode,$blob,$path"
}

upstream_history_markdown() {
  local path=$1 item index total shown=5 result=""
  local -a entries
  mapfile -t entries \
    < <(git log --format='%H%x09%s' "$previous_recorded..$target" -- "$path")
  total=${#entries[@]}
  if ((total == 0)); then
    printf '%s' 'none found in this sync range'
    return
  fi
  ((total < shown)) && shown=$total
  for ((index = 0; index < shown; index += 1)); do
    IFS=$'\t' read -r commit subject <<<"${entries[index]}"
    item="[\`${commit:0:7}\`](https://github.com/$upstream_repo/commit/$commit) $subject"
    [[ -z $result ]] || result+="; "
    result+=$item
  done
  if ((total > shown)); then
    result+="; and $((total - shown)) more"
  fi
  printf '%s' "$result"
}

upstream_subjects() {
  local path=$1 subject result=""
  while IFS= read -r subject; do
    [[ -z $result ]] || result+="; "
    result+=$subject
  done < <(git log -n 5 --format='%s' "$previous_recorded..$target" -- "$path")
  printf '%s' "${result:-No upstream subject found}"
}

port_history_markdown() {
  local path=$1 commit subject author item result=""
  while IFS=$'\t' read -r commit subject author; do
    item="\`$commit\` $subject ($author)"
    [[ -z $result ]] || result+="; "
    result+=$item
  done < <(git log -n 3 --format='%h%x09%s%x09%an' "$ours" -- "$path")
  printf '%s' "${result:-none found}"
}

build_conflict_report() {
  local path=$1 include_details=$2 file="$tmp_dir/conflict-report-file"
  local range start end link links="" report excerpt length omitted
  local -a hunks

  git show "$sync_commit:$path" >"$file"
  mapfile -t hunks < <(ryoku_marker_hunks "$file")
  report="#### \`$path\`"$'\n'
  for range in "${hunks[@]}"; do
    start=${range%%:*}
    end=${range##*:}
    link="[$start-$end](https://github.com/$repository/blob/$sync_commit/$path#L$start-L$end)"
    [[ -z $links ]] || links+=" · "
    links+=$link
  done
  report+="Lines ${links:-not found}"$'\n'
  report+="- Upstream changed it in: $(upstream_history_markdown "$path")"$'\n'
  report+="- Last port changes: $(port_history_markdown "$path")"$'\n'

  if ((include_details)); then
    report+=$'\n<details><summary>Show the conflict</summary>\n\n```text\n'
    for range in "${hunks[@]}"; do
      start=${range%%:*}
      end=${range##*:}
      report+="@@ Lines $start-$end @@"$'\n'
      excerpt=$(LC_ALL=C awk -v start="$start" -v end="$end" '
        NR >= start && NR <= end && NR < start + 40 { print }
      ' "$file")
      report+="$excerpt"$'\n'
      length=$((end - start + 1))
      if ((length > 40)); then
        omitted=$((length - 40))
        report+="... $omitted more lines"$'\n'
      fi
    done
    report+=$'```\n</details>\n'
  fi
  printf '%s' "$report"
}

build_pr_body_variant() {
  local previous=$1 target=$2 include_details=$3 file_limit=$4
  local excerpts_omitted=$5 check_text path report index omitted

  if ((${#conflicts[@]})); then
    pr_body="**What to do:** ${#conflicts[@]} files need a decision (listed below). Fix them on this branch, push, merge once the Sync PR checks are green."
    check_text="Blocked until the files under Needs a decision are fixed."
  else
    pr_body='**What to do:** merge once the ryoku-sync/checks status is green.'
    check_text="Pending: the ryoku-sync/checks status runs against this commit."
  fi
  pr_body+=$(printf '\n\nSyncs Ryoku `%s...%s`.\n\nUpstream: https://github.com/%s/compare/%s...%s\n' \
    "$previous" "$target" "$upstream_repo" "$previous" "$target")
  if ((${#conflicts[@]})); then
    pr_body+=$'\n### Needs a decision: '
    pr_body+="${#conflicts[@]} files"$'\n\n'
    pr_body+='Check out the branch, fix the marked lines, push. The bot stops touching the branch once you push; the "Sync PR" checks then run on your commit.'
    pr_body+=$'\n\n    git fetch origin && git switch sync/'
    pr_body+="$lane"$'\n'
    if ((excerpts_omitted)); then
      pr_body+=$'\nConflict excerpts omitted to keep this report under the body limit.\n'
    fi
    for ((index = 0; index < file_limit; index += 1)); do
      report=$(build_conflict_report "${conflicts[index]}" "$include_details")
      pr_body+=$'\n'
      pr_body+="$report"$'\n'
    done
    omitted=$((${#conflicts[@]} - file_limit))
    if ((omitted > 0)); then
      pr_body+=$'\nand '
      pr_body+="$omitted more files"$'\n'
    fi
  fi
  if ((${#notes[@]})); then
    pr_body+=$'\n### What changed upstream\n\n'
    if ((${#notes[@]} > 15)); then
      pr_body+="${#notes[@]} user-facing changes."$'\n\n<details>\n<summary>Show them</summary>\n\n'
    fi
    for note in "${notes[@]}"; do
      pr_body+="- $note"$'\n'
    done
    if ((${#notes[@]} > 15)); then
      pr_body+=$'\n</details>\n'
    fi
  fi
  if ((${#stale_copies[@]})); then
    pr_body+=$'\n### Stale copies refreshed from upstream\n\n'
    pr_body+="${#stale_copies[@]} paths were reset to their current upstream versions."$'\n'
    if ((${#stale_copies[@]} > 20)); then
      pr_body+=$'\n<details>\n<summary>Show paths</summary>\n\n'
    fi
    for path in "${stale_copies[@]}"; do
      pr_body+="- \`$path\`"$'\n'
    done
    if ((${#stale_copies[@]} > 20)); then
      pr_body+=$'\n</details>\n'
    fi
  fi
  if ((${#owned_upstream_changes[@]})); then
    pr_body+=$'\n### Upstream changed files the port owns\n\n'
    pr_body+="The sync keeps the port's copies. Port whatever applies, for example a new package input or build step:"$'\n'
    for path in "${owned_upstream_changes[@]}"; do
      pr_body+="- \`$path\`"$'\n'
    done
  fi
  if ((${#removed_paths[@]})); then
    pr_body+=$'\n### Removed because upstream removed them\n\n'
    pr_body+="Check that the port does not still need these:"$'\n'
    if ((${#removed_paths[@]} > 20)); then
      pr_body+=$'\n<details>\n<summary>Show paths</summary>\n\n'
    fi
    for path in "${removed_paths[@]}"; do
      pr_body+="- \`$path\`"$'\n'
    done
    if ((${#removed_paths[@]} > 20)); then
      pr_body+=$'\n</details>\n'
    fi
  fi
  pr_body+=$'\nChecks: '
  pr_body+="$check_text"
  pr_body+=$'\n\n'
  pr_body+="<!-- ryoku-sync-head: $sync_commit -->"
}

build_pr_body() {
  local previous=$1 target=$2 file_limit=${#conflicts[@]}

  build_pr_body_variant "$previous" "$target" 1 "$file_limit" 0
  if ((${#pr_body} >= body_cap)) && ((file_limit > 0)); then
    build_pr_body_variant "$previous" "$target" 0 "$file_limit" 1
  fi
  while ((${#pr_body} >= body_cap)) && ((file_limit > 0)); do
    ((file_limit -= 1))
    build_pr_body_variant "$previous" "$target" 0 "$file_limit" 1
  done
  ((${#pr_body} < body_cap)) \
    || die "pull request body cannot fit within RYOKU_SYNC_BODY_CAP=$body_cap"
}

create_conflict_check() {
  local path file="$tmp_dir/check-conflict-file" range start end message
  local annotations='[]' payload="$tmp_dir/check-run.json"
  local total=0 included=0 remaining summary

  for path in "${conflicts[@]}"; do
    git show "$sync_commit:$path" >"$file"
    message="Port and upstream both changed these lines. Upstream: $(upstream_subjects "$path")"
    while IFS=: read -r start end; do
      [[ -n $start && -n $end ]] || continue
      ((total += 1))
      if ((included < 50)); then
        annotations=$(jq -c \
          --arg path "$path" \
          --argjson start "$start" \
          --argjson end "$end" \
          --arg message "$message" \
          '. + [{
            path: $path,
            start_line: $start,
            end_line: $end,
            annotation_level: "failure",
            message: $message
          }]' <<<"$annotations")
        ((included += 1))
      fi
    done < <(ryoku_marker_hunks "$file")
  done

  summary="$total conflict hunks across ${#conflicts[@]} files. Fix the marked lines on sync/$lane, then push."
  remaining=$((total - included))
  if ((remaining > 0)); then
    summary+=" $remaining more hunks are listed in the pull request because GitHub accepts 50 annotations per request."
  fi
  jq -n \
    --arg head "$sync_commit" \
    --arg title "${#conflicts[@]} files need a decision" \
    --arg summary "$summary" \
    --argjson annotations "$annotations" \
    '{
      name: "Sync conflicts",
      head_sha: $head,
      status: "completed",
      conclusion: "action_required",
      output: {
        title: $title,
        summary: $summary,
        annotations: $annotations
      }
    }' >"$payload"
  "$gh_command" api "repos/$repository/check-runs" \
    --method POST --input "$payload" >/dev/null
}

gh_find_pr() {
  "$gh_command" api "repos/$repository/pulls" --method GET \
    -f state=open -f base="$base_branch" -f head="${repository%%/*}:sync/$lane" \
    --jq '.[0].number // empty'
}
gh_get_pr_body() {
  local number=$1
  "$gh_command" api "repos/$repository/pulls/$number" --method GET --jq '.body // ""'
}


gh_create_pr() {
  local title=$1 body=$2
  "$gh_command" api "repos/$repository/pulls" --method POST \
    -f title="$title" -f head="sync/$lane" -f base="$base_branch" -f body="$body" \
    --jq '.number'
}

gh_update_pr() {
  local number=$1 title=$2 body=$3
  "$gh_command" api "repos/$repository/pulls/$number" --method PATCH \
    -f title="$title" -f base="$base_branch" -f body="$body" >/dev/null
}

gh_set_pr_body() {
  local number=$1 body=$2
  "$gh_command" api "repos/$repository/pulls/$number" --method PATCH \
    -f body="$body" >/dev/null
}

# Keeps one "Newer Ryoku waiting" line in the PR body, replaced on each run,
# instead of a new comment every twenty minutes.
note_waiting_target() {
  local number=$1 message=$2 body line kept=""
  body=$(gh_get_pr_body "$number")
  while IFS= read -r line; do
    [[ $line == 'Newer Ryoku waiting: '* ]] && continue
    kept+="$line"$'\n'
  done <<<"$body"
  gh_set_pr_body "$number" "${kept%$'\n'}"$'\n\n'"$message"
}

gh_label_pr() {
  local number=$1
  "$gh_command" api "repos/$repository/issues/$number/labels" --method POST \
    -f 'labels[]=sync' >/dev/null
}

emit_output() {
  local key=$1 value=$2
  [[ -n ${GITHUB_OUTPUT:-} ]] || return 0
  printf '%s=%s\n' "$key" "$value" >>"$GITHUB_OUTPUT"
}

fetch_fork_branch "$base_branch"
fetch_optional_fork_branch "sync/$lane" || true
fetch_upstream_branch

if [[ $lane == stable ]]; then
  fetch_fork_branch unstable-dev
  fetch_upstream_main_and_tags
  target=$(upstream_target_stable)
  if ! stable_state=$(find_stable_fork_state "$target"); then
    printf 'no fork state matches the stable release yet\n'
    emit_output created false
    emit_output conflicts 0
    exit 0
  fi
  read -r ours merge_base <<<"$stable_state"
  parent=$(git rev-parse "$fork_base_ref^{commit}")
  # A main that predates the sync bot records nothing; its first stable sync
  # is measured from the unstable state it is built on.
  if ! previous_recorded=$(read_sync_commit "$parent" 2>/dev/null); then
    previous_recorded=$merge_base
  fi
else
  target=$(upstream_target_unstable)
  ours=$(git rev-parse "$fork_base_ref^{commit}")
  parent=$ours
  merge_base=$(read_sync_commit "$ours")
  previous_recorded=$merge_base
fi

git cat-file -e "$merge_base^{commit}" 2>/dev/null || die "recorded upstream commit is unavailable: $merge_base"
git cat-file -e "$previous_recorded^{commit}" 2>/dev/null \
  || die "base branch upstream commit is unavailable: $previous_recorded"
if git merge-base --is-ancestor "$target" "$previous_recorded"; then
  printf 'Ryoku %s already includes target %s\n' "$lane" "$target"
  emit_output created false
  emit_output conflicts 0
  exit 0
fi

open_pr_number=""
if ((dry_run == 0)) && git show-ref --verify --quiet "$sync_ref"; then
  branch_recorded=$(read_sync_commit "$sync_ref" 2>/dev/null || true)
  if ! sync_branch_is_reusable; then
    if [[ $branch_recorded == "$target" ]]; then
      printf 'sync/%s already carries %s and has maintainer commits\n' "$lane" "$target"
    else
      message="Newer Ryoku waiting: $target. sync/$lane has a maintainer commit, so the bot left it unchanged; merge this PR and the next sync follows."
      printf '%s\n' "$message"
      note_waiting_target "$open_pr_number" "$message"
    fi
    emit_output created false
    emit_output conflicts 0
    exit 0
  fi
  # Rebuilding an unchanged sync would only force-push a new timestamp and
  # rerun the checks every twenty minutes.
  if [[ -n $open_pr_number && $branch_recorded == "$target" ]] \
    && [[ $(git rev-parse "$sync_ref^") == "$parent" ]]; then
    printf 'sync/%s is already up to date with %s\n' "$lane" "$target"
    emit_output created false
    emit_output conflicts 0
    exit 0
  fi
fi

merge_output="$tmp_dir/merge-output"
set +e
git merge-tree --write-tree --merge-base="$merge_base" --name-only --no-messages -z \
  "$ours" "$target" >"$merge_output"
merge_status=$?
set -e
((merge_status <= 1)) || die "git merge-tree failed"
mapfile -d '' -t merge_records <"$merge_output"
((${#merge_records[@]} >= 1)) || die "git merge-tree produced no tree"
merged_tree=${merge_records[0]}
initial_conflicts=("${merge_records[@]:1}")
collect_stale_copies "$merge_base" "$ours"


index="$tmp_dir/index"
rm -f "$index"
GIT_INDEX_FILE=$index git read-tree "$merged_tree"
remove_index_paths "$index" "${FORK_OWNED_PATHS[@]}"
restore_index_paths "$index" "$ours" "${FORK_OWNED_PATHS[@]}"
set_index_file "$index" "$target" VERSION
for path in "${stale_copies[@]}"; do
  set_index_file "$index" "$target" "$path"
done


conflicts=()
for path in "${initial_conflicts[@]}"; do
  if is_fork_owned "$path" || [[ $path == VERSION ]]; then
    continue
  fi
  if [[ -n ${STALE_COPY_SET["$path"]-} ]]; then
    continue
  fi
  if ! path_exists "$ours" "$path" && path_exists "$merge_base" "$path"; then
    remove_index_paths "$index" "$path"
    continue
  fi
  if is_upstream_wins "$path"; then
    set_index_file "$index" "$target" "$path"
    continue
  fi

  if ! path_exists "$merge_base" "$path" && path_exists "$target" "$path" \
    && under_removed_directory "$path" "$merge_base" "$ours"; then
    remove_index_paths "$index" "$path"
    continue
  fi
  conflicts+=("$path")
done

while IFS= read -r -d '' path; do
  is_fork_owned "$path" && continue
  if under_removed_directory "$path" "$merge_base" "$ours"; then
    remove_index_paths "$index" "$path"
  fi
done < <(git diff-tree --no-commit-id --name-only --diff-filter=A -r -z "$merge_base" "$target")
while IFS= read -r -d '' path; do
  is_fork_owned "$path" && continue
  if is_upstream_wins "$path" && path_exists "$merge_base" "$path" \
    && path_exists "$ours" "$path"; then
    set_index_file "$index" "$target" "$path"
  fi
done < <(git diff-tree --no-commit-id --name-only -r -z "$merge_base" "$ours")


version=$(git show "$target:VERSION")
version=${version%%$'\n'*}
[[ -n $version ]] || die "upstream VERSION is empty"
for path in "${conflicts[@]}"; do
  relabel_conflict_file "$index" "$path"
done

sync_blob=$(printf '%s\n' "$target" | git hash-object -w --stdin)
GIT_INDEX_FILE=$index git update-index --add --cacheinfo "100644,$sync_blob,nix/sync/ryoku-commit"
final_tree=$(GIT_INDEX_FILE=$index git write-tree)

commit_message=$(printf 'sync: Ryoku %s (%s)\n\nRyoku-Commit: %s\nRyoku-Lane: %s\n' \
  "$version" "$lane" "$target" "$lane")
sync_commit=$(printf '%s' "$commit_message" \
  | GIT_AUTHOR_NAME='github-actions[bot]' \
    GIT_AUTHOR_EMAIL='41898282+github-actions[bot]@users.noreply.github.com' \
    GIT_COMMITTER_NAME='github-actions[bot]' \
    GIT_COMMITTER_EMAIL='41898282+github-actions[bot]@users.noreply.github.com' \
    git commit-tree "$final_tree" -p "$parent")

mapfile -d '' -t changed_paths < <(git diff-tree --no-commit-id --name-only -r -z "$parent" "$sync_commit")
# Measured from the fork state that was merged, not the parent: on stable the
# parent is the older main, and its differences are already-reviewed port work.
removed_paths=()
while IFS= read -r -d '' path; do
  is_upstream_wins "$path" || removed_paths+=("$path")
done < <(git diff-tree --no-commit-id --name-only --diff-filter=D -r -z "$ours" "$sync_commit")
# Upstream edits to port-owned paths never enter the tree, so name them: the
# upstream flake packaging a new module is exactly what the port must copy.
owned_upstream_changes=()
while IFS= read -r -d '' path; do
  is_fork_owned "$path" && owned_upstream_changes+=("$path")
done < <(git diff-tree --no-commit-id --name-only -r -z "$merge_base" "$target" -- "${FORK_OWNED_PATHS[@]}")
collect_notes "$previous_recorded..$target"
build_pr_body "$previous_recorded" "$target"

printf 'Target: %s\n' "$target"
printf 'Tree: %s\n' "$final_tree"
printf 'Commit: %s\n' "$sync_commit"
printf 'Changed files: %d\n' "${#changed_paths[@]}"
printf 'Stale copies refreshed: %d\n' "${#stale_copies[@]}"
printf 'Removed by upstream: %d\n' "${#removed_paths[@]}"
printf 'Upstream changes to port-owned files: %d\n' "${#owned_upstream_changes[@]}"
if ((${#conflicts[@]})); then
  printf 'Conflicts (%d):\n' "${#conflicts[@]}"
  printf '  %s\n' "${conflicts[@]}"
else
  printf 'Conflicts: none\n'
fi
printf '\nPR body:\n%s\n' "$pr_body"

emit_output created true
emit_output head "$sync_commit"
emit_output conflicts "${#conflicts[@]}"
emit_output changed_files "${#changed_paths[@]}"

if ((dry_run)); then
  exit 0
fi

if git show-ref --verify --quiet "$sync_ref"; then
  expected_old=$(git rev-parse "$sync_ref")
else
  expected_old=""
fi
git push --quiet \
  "--force-with-lease=refs/heads/sync/$lane:$expected_old" \
  "$fork_remote" "$sync_commit:refs/heads/sync/$lane"
if ((${#conflicts[@]})); then
  create_conflict_check
fi


pr_title="sync: Ryoku $version ($lane)"
pr_number=$(gh_find_pr)
if [[ -z $pr_number ]]; then
  pr_number=$(gh_create_pr "$pr_title" "$pr_body")
else
  gh_update_pr "$pr_number" "$pr_title" "$pr_body"
fi
gh_label_pr "$pr_number"
