+/// Run one command against the official Spotify desktop client's MPRIS player.
+async fn spotify_playerctl(args: &[&str]) -> Result<String, String> {
+    let output = tokio::process::Command::new("playerctl")
+        .arg("-p")
+        .arg("spotify")
+        .args(args)
+        .output()
+        .await
+        .map_err(|e| format!("could not launch playerctl: {e}"))?;
+
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        let message = stderr.trim();
+
+        return Err(if message.is_empty() {
+            format!("playerctl exited with {}", output.status)
+        } else {
+            message.to_owned()
+        });
+    }
+
+    Ok(String::from_utf8_lossy(&output.stdout)
+        .trim()
+        .to_owned())
+}
