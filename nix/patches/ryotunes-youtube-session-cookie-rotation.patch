+/// Merge browser-style `Set-Cookie` rotations into a request `Cookie` header. YouTube rotates
+/// `__Secure-*SIDTS` while a session is alive; keeping the login-time snapshot forever eventually
+/// makes an otherwise-valid account look signed out. Attributes stay response-only — the request
+/// header stores just name/value pairs, exactly like the login harvester.
+fn merge_set_cookie_headers(current: &str, headers: &HeaderMap) -> Option<String> {
+    let mut cookies: Vec<(String, String)> = current
+        .split(';')
+        .filter_map(|part| {
+            let (name, value) = part.trim().split_once('=')?;
+            (!name.is_empty()).then(|| (name.to_owned(), value.to_owned()))
+        })
+        .collect();
+    let mut changed = false;
+
+    for header in headers.get_all(SET_COOKIE).iter() {
+        let Ok(raw) = header.to_str() else { continue };
+        let mut parts = raw.split(';');
+        let Some(pair) = parts.next() else { continue };
+        let Some((name, value)) = pair.trim().split_once('=') else { continue };
+        if name.is_empty() {
+            continue;
+        }
+
+        let remove = parts.any(|attribute| {
+            let attribute = attribute.trim();
+            attribute.eq_ignore_ascii_case("max-age=0")
+                || attribute.to_ascii_lowercase().starts_with("expires=thu, 01 jan 1970")
+        });
+
+        if remove {
+            let before = cookies.len();
+            cookies.retain(|(existing, _)| existing != name);
+            changed |= cookies.len() != before;
+            continue;
+        }
+
+        if let Some((_, existing)) = cookies.iter_mut().find(|(existing, _)| existing == name) {
+            if existing != value {
+                *existing = value.to_owned();
+                changed = true;
+            }
+        } else {
+            cookies.push((name.to_owned(), value.to_owned()));
+            changed = true;
+        }
+    }
+
+    changed.then(|| {
+        cookies
+            .into_iter()
+            .map(|(name, value)| format!("{name}={value}"))
+            .collect::<Vec<_>>()
+            .join("; ")
+    })
+}
