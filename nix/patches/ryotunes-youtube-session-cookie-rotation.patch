+    /// Persist server-driven cookie rotations without coupling this transport crate to the app DB.
+    /// Login still owns the initial cookie write; this sink is only called when an authenticated
+    /// YouTube response refreshes the browser-style cookie jar.
+    pub fn set_cookie_refresh_sink<F>(&self, sink: F)
+    where
+        F: Fn(&str, &str) + Send + Sync + 'static,
+    {
+        *self.cookie_refresh_sink.write().unwrap() = Some(Arc::new(sink));
+    }
+
+    fn refresh_cookie_from_headers(&self, headers: &HeaderMap) -> bool {
+        // Keep the session lock through the sink call. Responses may finish concurrently; this
+        // preserves rotation order so persistence cannot land one generation behind the live jar.
+        let mut session = self.session.write().unwrap();
+        let Some(current) = session.cookie.as_deref().map(str::to_owned) else { return false };
+        let Some(updated) = merge_set_cookie_headers(&current, headers) else { return false };
+        session.cookie = Some(updated.clone());
+
+        if let Some(sink) = self.cookie_refresh_sink.read().unwrap().clone() {
+            sink(&current, &updated);
+        }
+        true
+    }
