+    fn restore_previous_or_keep_pending_auth(
+        &self,
+        previous_cookie: Option<String>,
+        previous_data_sync_id: Option<String>,
+        authenticated_visitor_data: Option<&str>,
+    ) {
+        if previous_cookie.is_some() {
+            self.restore_auth_transport(previous_cookie.clone(), previous_data_sync_id);
+            self.restore_session_cookie_setting(previous_cookie.as_deref());
+        } else {
+            // `account_menu` already proved this first login and its cookie was persisted as pending.
+            // A flaky identity endpoint must not turn that authenticated session back into logout.
+            self.it.set_data_sync_id(None);
+            self.persist_visitor_data(authenticated_visitor_data);
+        }
+    }
