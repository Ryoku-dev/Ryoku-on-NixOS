+    });
+    var stickers = [];
+    var used = {};
+    if (Array.isArray(rawCanvas.stickers)) {
+        rawCanvas.stickers.slice(0, 24).forEach(function(s) {
+            if (!s || !validId(s.item) || !stamp(s.item) || used[s.slot])
