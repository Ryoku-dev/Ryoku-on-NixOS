+    const available = P.availableStickers(state);
+    assert.equal(available.length, 1);
+    assert.equal(available[0].id, "welcome");
+    assert.equal(P.addSticker({}, "welcome").changed, false);
+    const placed = P.addSticker(state, "welcome");
