index 00000000..44faf1f0
--- /dev/null
+++ b/ryoku/hub/quickshell/components/about/AchievementCard.qml
@@ -0,0 +1,154 @@
+import QtQuick
+import Lithic
+import Ryoku.Ui.Singletons
+import "../../Singletons"
+import ".."
+
+Item {
+    id: card
+    required property var badge
+    signal claimRequested(var badge)
+    signal featureRequested(string id)
+
+    readonly property bool earned: Progression.data.earned[badge.id] === true
+    readonly property bool claimed: Progression.data.claimed[badge.id] === true
+    readonly property bool prestigious: badge.category === "Mastery" || badge.category === "Classified"
+    readonly property var progress: Progression.progressInfoFor(badge.id)
+    readonly property color metal: Progression.rarityColours[badge.rarity] || Lithic.fg2
+
+    implicitHeight: 304
+
+    CutRect {
+        anchors.fill: parent
+        cut: card.prestigious ? LithicTokens.cut.large : LithicTokens.cut.small
+        fill: Lithic.mix(Lithic.ground, card.metal, card.prestigious ? 0.075 : 0.025)
+        strokeColor: card.earned ? card.metal : Lithic.mix(Lithic.ground, Lithic.fg, 0.24)
+        strokeWidth: card.prestigious ? 2 : 1
+    }
+
+    ArchiveSeal {
+        id: emblem
+        badgeId: card.badge.id
+        x: 19
+        y: 27
+        width: 124
+        height: 124
+        title: card.badge.title
+        sigil: card.badge.sigil
+        rarity: card.badge.rarity
+        category: card.badge.category
+        locked: !card.earned
+        animateFoil: card.visible && card.earned &&
+            card.badge.rarity === "holographic" && !Lithic.reduceMotion
+    }
+
+    Column {
+        x: 158
+        y: 29
+        width: Math.max(0, parent.width - x - 18)
+        spacing: 9
+        Label {
+            width: parent.width
+            text: card.badge.title
+            typeRole: "section"
+            wrapMode: Text.Wrap
+            elide: Text.ElideRight
+            maximumLineCount: 2
+        }
+        Label {
+            text: card.badge.rarity.toUpperCase()
+            typeRole: "monoSm"
+            ink: card.metal
+        }
+        Label {
+            text: "+" + card.badge.reward + " ◆"
+            typeRole: "mono"
+            ink: Lithic.gold
+        }
+    }
+
+    Label {
+        x: 20
+        y: 167
+        width: parent.width - 40
+        height: 43
+        text: card.badge.detail
+        typeRole: "detail"
+        inkRole: card.earned ? "fg" : "fg2"
+        wrapMode: Text.Wrap
+        elide: Text.ElideRight
+        maximumLineCount: 2
+        verticalAlignment: Text.AlignVCenter
+    }
+
+    Item {
+        id: tracker
+        x: 20
+        y: 218
+        width: parent.width - 40
+        height: 31
+        visible: card.progress !== null && !card.earned
+
+        Label {
+            anchors.left: parent.left
+            anchors.top: parent.top
+            text: card.progress ? card.progress.label : ""
+            typeRole: "monoSm"
+            inkRole: "fg2"
+        }
+        Label {
+            anchors.right: parent.right
+            anchors.top: parent.top
+            text: card.progress ? card.progress.current + " / " + card.progress.total : ""
+            typeRole: "monoSm"
+            ink: card.metal
+        }
+        Rectangle {
+            anchors.bottom: parent.bottom
+            width: parent.width
+            height: 3
+            color: Lithic.mix(Lithic.ground, card.metal, 0.18)
+            Rectangle {
+                width: parent.width * (card.progress ? card.progress.fraction : 0)
+                height: parent.height
+                color: card.metal
+                Behavior on width {
+                    enabled: !Lithic.reduceMotion
+                    NumberAnimation { duration: 240; easing.type: Easing.OutCubic }
+                }
+            }
+        }
+    }
+
+    Row {
+        anchors.right: parent.right
+        anchors.rightMargin: 19
+        y: parent.height - 47
+        height: 32
+        spacing: 8
+        Plaque {
+            small: true
+            visible: card.earned && !card.claimed
+            kind: "gold"
+            text: I18n.tr("Claim")
+            onClicked: card.claimRequested(card.badge)
+        }
+        Plaque {
+            small: true
+            visible: card.claimed
+            kind: Progression.featuredBadge === card.badge.id ? "gold" : "line"
+            text: Progression.featuredBadge === card.badge.id ? I18n.tr("Featured") : I18n.tr("Feature")
+            enabled: Progression.featuredBadge !== card.badge.id
+            onClicked: card.featureRequested(card.badge.id)
+        }
+    }
+
+    Label {
+        x: 20
+        y: parent.height - 38
+        visible: card.earned && !card.claimed
+        text: I18n.tr("Reward ready")
+        typeRole: "detail"
+        ink: card.metal
+    }
+}
diff --git a/ryoku/hub/quickshell/components/about/AchievementReveal.qml b/ryoku/hub/quickshell/components/about/AchievementReveal.qml
new file mode 100644
index 00000000..ce9f4c92
--- /dev/null
+++ b/ryoku/hub/quickshell/components/about/AchievementReveal.qml
@@ -0,0 +1,165 @@
+import QtQuick
+import Lithic
+import Ryoku.Ui.Singletons
+import "../../Singletons"
+import ".."
+
+FocusScope {
+    id: reveal
+
+    property var badge: null
+    property bool opened: false
+    property real burst: 0
+    readonly property color metal: badge ?
+        Progression.rarityColours[badge.rarity] || Lithic.gold : Lithic.gold
+
+    visible: opened
+    z: 400
+    focus: opened
+
+    function present(entry) {
+        if (!entry) return;
+        badge = entry;
+        burst = 0;
+        opened = true;
+        forceActiveFocus();
+        if (!Lithic.reduceMotion) entrance.restart();
+        else burst = 1;
+    }
+
+    function dismiss() {
+        opened = false;
+        badge = null;
+    }
+
+    Keys.onEscapePressed: event => {
+        reveal.dismiss();
+        event.accepted = true;
+    }
+
+    SequentialAnimation {
+        id: entrance
+        NumberAnimation {
+            target: reveal
+            property: "burst"
+            from: 0
+            to: 1
+            duration: 820
+            easing.type: Easing.OutCubic
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: "#07090d"
+        opacity: 0.93
+        MouseArea {
+            anchors.fill: parent
+            onClicked: reveal.dismiss()
+        }
+    }
+
+    Item {
+        anchors.centerIn: parent
+        width: Math.min(parent.width - 32, 530)
+        height: Math.min(parent.height - 24, 585)
+        scale: Lithic.reduceMotion ? 1 : 0.87 + reveal.burst * 0.13
+        opacity: Lithic.reduceMotion ? 1 : Math.min(1, reveal.burst * 2)
+
+        CutRect {
+            anchors.fill: parent
+            cut: 30
+            fill: "#10131a"
+            strokeColor: reveal.metal
+            strokeWidth: 2
+        }
+
+        Repeater {
+            model: 4
+            delegate: Rectangle {
+                required property int index
+                width: parent.width * (0.30 + index * 0.14)
+                height: width
+                anchors.horizontalCenter: parent.horizontalCenter
+                y: 65 - index * 16
+                rotation: 45 + (Lithic.reduceMotion ? 0 : reveal.burst * (index % 2 ? -12 : 12))
+                color: "transparent"
+                border.color: reveal.metal
+                border.width: 1
+                opacity: 0.28 - index * 0.04
+            }
+        }
+
+        Column {
+            anchors.fill: parent
+            anchors.margins: 22
+            spacing: 12
+
+            Label {
+                anchors.horizontalCenter: parent.horizontalCenter
+                text: reveal.badge && reveal.badge.category === "Classified" ?
+                    "CLASSIFIED / DECRYPTED" :
+                    reveal.badge && reveal.badge.category === "Mastery" ?
+                    "MASTERY / ACHIEVED" : "THE ARCHIVE REMEMBERS"
+                typeRole: "mono"
+                ink: reveal.metal
+            }
+            Label {
+                anchors.horizontalCenter: parent.horizontalCenter
+                text: "ACHIEVEMENT UNLOCKED"
+                typeRole: "monoSm"
+                inkRole: "fg2"
+            }
+
+            Item {
+                width: parent.width
+                height: Math.min(245, Math.max(150, reveal.height * 0.4))
+
+                ArchiveSeal {
+                    badgeId: reveal.badge ? reveal.badge.id : ""
+                    anchors.centerIn: parent
+                    width: Math.min(230, parent.height)
+                    height: width
+                    title: reveal.badge ? reveal.badge.title : ""
+                    sigil: reveal.badge ? reveal.badge.sigil : "力"
+                    rarity: reveal.badge ? reveal.badge.rarity : "common"
+                    category: reveal.badge ? reveal.badge.category : "RYOKU"
+                    animateFoil: reveal.opened && reveal.badge &&
+                        reveal.badge.rarity === "holographic" && !Lithic.reduceMotion
+                }
+            }
+            Label {
+                width: parent.width
+                text: reveal.badge ? reveal.badge.title : ""
+                typeRole: "title"
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.Wrap
+                elide: Text.ElideNone
+            }
+            Label {
+                width: parent.width
+                text: reveal.badge ? reveal.badge.rarity.toUpperCase() + " / +" +
+                    reveal.badge.reward + " ◆" : ""
+                typeRole: "mono"
+                ink: reveal.metal
+                horizontalAlignment: Text.AlignHCenter
+            }
+            Label {
+                width: parent.width
+                text: "Collected. Your badge is now available to feature or place on your profile."
+                typeRole: "detail"
+                inkRole: "fg2"
+                wrapMode: Text.Wrap
+                elide: Text.ElideNone
+                horizontalAlignment: Text.AlignHCenter
+            }
+            Item { width: 1; height: 4 }
+            Plaque {
+                anchors.horizontalCenter: parent.horizontalCenter
+                kind: "gold"
+                text: "Return to archive"
+                onClicked: reveal.dismiss()
+            }
+        }
+    }
+}
diff --git a/ryoku/hub/quickshell/components/about/ArchiveSeal.qml b/ryoku/hub/quickshell/components/about/ArchiveSeal.qml
new file mode 100644
index 00000000..6b3fd0c9
--- /dev/null
+++ b/ryoku/hub/quickshell/components/about/ArchiveSeal.qml
@@ -0,0 +1,76 @@
+import QtQuick
+import Lithic
+import ".."
+
+Item {
+    id: seal
+
+    property string badgeId: ""
+    property string title: "RYOKU"
+    property string sigil: "力"
+    property string rarity: "common"
+    property string category: "Ryoku"
+    property bool locked: false
+    property bool animateFoil: false
+
+    readonly property bool moving: animateFoil && visible &&
+        rarity === "holographic" && !locked && !Lithic.reduceMotion
+
+    implicitWidth: 150
+    implicitHeight: 150
+    clip: false
+
+    Image {
+        id: emblem
+        anchors.fill: parent
+        source: seal.visible && seal.badgeId !== "" ?
+            Qt.resolvedUrl("../../assets/badges/" + seal.badgeId + ".svg") : ""
+        sourceSize.width: Math.max(150, Math.round(width * 2))
+        sourceSize.height: Math.max(150, Math.round(height * 2))
+        fillMode: Image.PreserveAspectFit
+        smooth: true
+        asynchronous: true
+        opacity: seal.locked ? 0.29 : 1
+    }
+
+    Rectangle {
+        visible: emblem.status !== Image.Ready
+        anchors.centerIn: parent
+        width: parent.width * 0.7
+        height: width
+        rotation: 45
+        color: "transparent"
+        border.color: Lithic.fg3
+        border.width: 1
+        Label {
+            anchors.centerIn: parent
+            text: "力"
+            typeRole: "section"
+        }
+    }
+
+    Rectangle {
+        id: glint
+        visible: seal.moving
+        width: Math.max(4, seal.width * 0.13)
+        height: seal.height * 1.45
+        y: -seal.height * 0.22
+        opacity: 0.28
+        rotation: 25
+        x: -width * 2
+        gradient: Gradient {
+            GradientStop { position: 0; color: "transparent" }
+            GradientStop { position: 0.45; color: "#86b8cb" }
+            GradientStop { position: 0.6; color: "#f4b8c4" }
+            GradientStop { position: 1; color: "transparent" }
+        }
+
+        NumberAnimation on x {
+            from: -glint.width * 2
+            to: seal.width + glint.width * 2
+            duration: 4900
+            loops: Animation.Infinite
+            running: seal.moving
+        }
+    }
+}
