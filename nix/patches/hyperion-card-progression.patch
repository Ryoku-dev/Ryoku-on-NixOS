+import QtQuick
+import Lithic
+import Ryoku.Ui.Singletons
+import "../../Singletons"
+import ".."
+
+Item {
+    id: card
+
+    required property var badge
+    signal claimRequested(var badge)
+    signal featureRequested(string id)
+
+    readonly property bool earned: Progression.data.earned[badge.id] === true
+    readonly property bool claimed: Progression.data.claimed[badge.id] === true
+    readonly property bool mastery: badge.category === "Mastery"
+    readonly property bool classified: badge.category === "Classified"
+    readonly property var progress: Progression.progressInfoFor(badge.id)
+    readonly property color metal: Progression.rarityColours[badge.rarity] || Lithic.fg2
+    readonly property bool brilliant: badge.rarity === "holographic"
+    readonly property bool prestigious: mastery || classified
+    readonly property string status: claimed ? "ARCHIVED" : earned ? "READY TO CLAIM" : "UNDISCOVERED"
+    readonly property real cutSize: prestigious ? 22 : 12
+
+    implicitHeight: prestigious ? 314 : 294
+    clip: true
+
+    HoverHandler { id: hover; enabled: !Lithic.reduceMotion }
+
+    CutRect {
+        anchors.fill: parent
+        cut: card.cutSize
+        fill: card.prestigious ? Lithic.mix(Lithic.ground, card.metal, card.earned ? 0.12 : 0.055)
+            : Lithic.mix(Lithic.ground, Lithic.fg, card.earned ? 0.065 : 0.026)
+        strokeColor: card.earned ? card.metal : Lithic.mix(Lithic.ground, Lithic.fg, 0.22)
+        strokeWidth: card.prestigious ? 2 : 1
+    }
+
+    Rectangle {
+        x: 3
+        y: 30
+        width: card.earned ? 3 : 1
+        height: parent.height - 61
+        color: card.metal
+        opacity: card.earned ? 0.9 : 0.23
+    }
+
+    Rectangle {
+        x: 22
+        y: 36
+        width: parent.width - 44
+        height: 1
+        color: card.metal
+        opacity: card.prestigious ? 0.55 : 0.25
+    }
+
+    Rectangle {
+        x: 22
+        y: parent.height - 62
+        width: parent.width - 44
+        height: 1
+        color: card.metal
+        opacity: card.prestigious ? 0.6 : 0.22
+    }
+
+    Row {
+        x: 20
+        y: 10
+        width: parent.width - 40
+        spacing: 7
+
+        Label {
+            text: card.classified ? "DECRYPTED / 07" :
+                card.mastery ? "MASTERY / ARCHIVE" : "RYOKU / " + card.badge.category.toUpperCase()
+            typeRole: "monoSm"
+            ink: card.metal
+        }
+        Item { width: Math.max(0, parent.width - 260); height: 1 }
+        Label {
+            text: card.badge.rarity.toUpperCase()
+            typeRole: "monoSm"
+            ink: card.metal
+        }
+    }
+
+    Item {
+        id: insignia
+        x: 17
+        y: 50
+        width: card.prestigious ? 137 : 125
+        height: width
+
+        Rectangle {
+            visible: card.prestigious && card.earned
+            anchors.centerIn: parent
+            width: parent.width * 0.91
+            height: width
+            rotation: 45
+            color: "transparent"
+            border.color: card.metal
+            border.width: 1
+            opacity: card.brilliant ? 0.45 : 0.28
+        }
+
+        ArchiveSeal {
+            anchors.fill: parent
+            title: card.badge.title
+            sigil: card.badge.sigil
+            rarity: card.badge.rarity
+            category: card.badge.category
+            locked: !card.earned
+            animateFoil: card.earned && card.brilliant && card.visible &&
+                !Lithic.reduceMotion
+        }
+    }
+
+    Column {
+        x: insignia.x + insignia.width + 10
+        y: 54
+        width: Math.max(10, parent.width - x - 16)
+        spacing: 9
+
+        Label {
+            width: parent.width
+            text: card.badge.title
+            typeRole: "section"
+            wrapMode: Text.Wrap
+            elide: Text.ElideRight
+            maximumLineCount: 2
+        }
+        Label {
+            width: parent.width
+            text: card.status
+            typeRole: "monoSm"
+            ink: card.earned ? card.metal : Lithic.fg3
+            elide: Text.ElideRight
+        }
+        Label {
+            width: parent.width
+            text: "+" + card.badge.reward + " ◆"
+            typeRole: "mono"
+            ink: Lithic.gold
+        }
+    }
+
+    Column {
+        x: 21
+        y: 200
+        width: parent.width - 42
+        spacing: 8
+
+        Label {
+            width: parent.width
+            text: card.badge.detail
+            typeRole: "detail"
+            inkRole: card.earned ? "fg" : "fg2"
+            wrapMode: Text.Wrap
+            elide: Text.ElideRight
+            maximumLineCount: 2
+        }
+
+        Item {
+            width: parent.width
+            height: 24
+            visible: card.progress !== null && !card.earned
+
+            Row {
+                anchors.top: parent.top
+                width: parent.width
+                Label {
+                    text: card.progress ? card.progress.label : ""
+                    typeRole: "monoSm"
+                    ink: card.metal
+                }
+                Item { width: Math.max(0, parent.width - 200); height: 1 }
+                Label {
+                    text: card.progress ? card.progress.current + " / " + card.progress.total : ""
+                    typeRole: "monoSm"
+                    ink: card.metal
+                }
+            }
+            Rectangle {
+                anchors.bottom: parent.bottom
+                width: parent.width
+                height: 3
+                color: Lithic.mix(Lithic.ground, card.metal, 0.16)
+                Rectangle {
+                    width: parent.width * (card.progress ? card.progress.fraction : 0)
+                    height: parent.height
+                    color: card.metal
+                    Behavior on width {
+                        enabled: !Lithic.reduceMotion
+                        NumberAnimation { duration: 320; easing.type: Easing.OutCubic }
+                    }
+                }
+            }
+        }
+    }
+
+    Row {
+        x: 20
+        y: parent.height - 52
+        width: parent.width - 40
+        spacing: 7
+
+        Label {
+            anchors.verticalCenter: parent.verticalCenter
+            text: card.claimed ? "IN YOUR ARCHIVE" : card.earned ? "REWARD AVAILABLE" : "CHALLENGE ACTIVE"
+            typeRole: "monoSm"
+            ink: card.earned ? card.metal : Lithic.fg3
+        }
+        Item { width: Math.max(0, parent.width - (card.claimed ? 300 : 270)); height: 1 }
+        Plaque {
+            small: true
+            kind: card.earned && !card.claimed ? "gold" : "quiet"
+            text: card.claimed ? "Claimed" : card.earned ? "Claim" : "Locked"
+            enabled: card.earned && !card.claimed
+            onClicked: card.claimRequested(card.badge)
+        }
+        Plaque {
+            visible: card.claimed
+            small: true
+            kind: Progression.featuredBadge === card.badge.id ? "gold" : "line"
+            text: Progression.featuredBadge === card.badge.id ? "Featured" : "Feature"
+            enabled: Progression.featuredBadge !== card.badge.id
+            onClicked: card.featureRequested(card.badge.id)
+        }
+    }
+}
diff --git a/ryoku/hub/quickshell/components/about/AchievementReveal.qml b/ryoku/hub/quickshell/components/about/AchievementReveal.qml
new file mode 100644
index 00000000..d6437945
--- /dev/null
+++ b/ryoku/hub/quickshell/components/about/AchievementReveal.qml
@@ -0,0 +1,164 @@
+import QtQuick
+import Lithic
+import Ryoku.Ui.Singletons
+import "../../Singletons"
+import ".."
+
+FocusScope {
+    id: reveal
+
+    property var badge: null
+    property bool opened: false
+    property real burst: 0
+    readonly property color metal: badge ?
+        Progression.rarityColours[badge.rarity] || Lithic.gold : Lithic.gold
+
+    visible: opened
+    z: 400
+    focus: opened
+
+    function present(entry) {
+        if (!entry) return;
+        badge = entry;
+        burst = 0;
+        opened = true;
+        forceActiveFocus();
+        if (!Lithic.reduceMotion) entrance.restart();
+        else burst = 1;
+    }
+
+    function dismiss() {
+        opened = false;
+        badge = null;
+    }
+
+    Keys.onEscapePressed: event => {
+        reveal.dismiss();
+        event.accepted = true;
+    }
+
+    SequentialAnimation {
+        id: entrance
+        NumberAnimation {
+            target: reveal
+            property: "burst"
+            from: 0
+            to: 1
+            duration: 820
+            easing.type: Easing.OutCubic
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: "#07090d"
+        opacity: 0.93
+        MouseArea {
+            anchors.fill: parent
+            onClicked: reveal.dismiss()
+        }
+    }
+
+    Item {
+        anchors.centerIn: parent
+        width: Math.min(parent.width - 32, 530)
+        height: Math.min(parent.height - 24, 585)
+        scale: Lithic.reduceMotion ? 1 : 0.87 + reveal.burst * 0.13
+        opacity: Lithic.reduceMotion ? 1 : Math.min(1, reveal.burst * 2)
+
+        CutRect {
+            anchors.fill: parent
+            cut: 30
+            fill: "#10131a"
+            strokeColor: reveal.metal
+            strokeWidth: 2
+        }
+
+        Repeater {
+            model: 4
+            delegate: Rectangle {
+                required property int index
+                width: parent.width * (0.30 + index * 0.14)
+                height: width
+                anchors.horizontalCenter: parent.horizontalCenter
+                y: 65 - index * 16
+                rotation: 45 + (Lithic.reduceMotion ? 0 : reveal.burst * (index % 2 ? -12 : 12))
+                color: "transparent"
+                border.color: reveal.metal
+                border.width: 1
+                opacity: 0.28 - index * 0.04
+            }
+        }
+
+        Column {
+            anchors.fill: parent
+            anchors.margins: 22
+            spacing: 12
+
+            Label {
+                anchors.horizontalCenter: parent.horizontalCenter
+                text: reveal.badge && reveal.badge.category === "Classified" ?
+                    "CLASSIFIED / DECRYPTED" :
+                    reveal.badge && reveal.badge.category === "Mastery" ?
+                    "MASTERY / ACHIEVED" : "THE ARCHIVE REMEMBERS"
+                typeRole: "mono"
+                ink: reveal.metal
+            }
+            Label {
+                anchors.horizontalCenter: parent.horizontalCenter
+                text: "ACHIEVEMENT UNLOCKED"
+                typeRole: "monoSm"
+                inkRole: "fg2"
+            }
+
+            Item {
+                width: parent.width
+                height: Math.min(245, Math.max(150, reveal.height * 0.4))
+
+                ArchiveSeal {
+                    anchors.centerIn: parent
+                    width: Math.min(230, parent.height)
+                    height: width
+                    title: reveal.badge ? reveal.badge.title : ""
+                    sigil: reveal.badge ? reveal.badge.sigil : "力"
+                    rarity: reveal.badge ? reveal.badge.rarity : "common"
+                    category: reveal.badge ? reveal.badge.category : "RYOKU"
+                    animateFoil: reveal.opened && reveal.badge &&
+                        reveal.badge.rarity === "holographic" && !Lithic.reduceMotion
+                }
+            }
+            Label {
+                width: parent.width
+                text: reveal.badge ? reveal.badge.title : ""
+                typeRole: "title"
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.Wrap
+                elide: Text.ElideNone
+            }
+            Label {
+                width: parent.width
+                text: reveal.badge ? reveal.badge.rarity.toUpperCase() + " / +" +
+                    reveal.badge.reward + " ◆" : ""
+                typeRole: "mono"
+                ink: reveal.metal
+                horizontalAlignment: Text.AlignHCenter
+            }
+            Label {
+                width: parent.width
+                text: "Collected. Your badge is now available to feature or place on your profile."
+                typeRole: "detail"
+                inkRole: "fg2"
+                wrapMode: Text.Wrap
+                elide: Text.ElideNone
+                horizontalAlignment: Text.AlignHCenter
+            }
+            Item { width: 1; height: 4 }
+            Plaque {
+                anchors.horizontalCenter: parent.horizontalCenter
+                kind: "gold"
+                text: "Return to archive"
+                onClicked: reveal.dismiss()
+            }
+        }
+    }
+}
diff --git a/ryoku/hub/quickshell/components/about/ArchiveSeal.qml b/ryoku/hub/quickshell/components/about/ArchiveSeal.qml
new file mode 100644
index 00000000..c5e2263b
--- /dev/null
+++ b/ryoku/hub/quickshell/components/about/ArchiveSeal.qml
@@ -0,0 +1,181 @@
+import QtQuick
+import Lithic
+
+Item {
+    id: seal
+
+    property string title: "RYOKU"
+    property string sigil: "力"
+    property string rarity: "common"
+    property string category: "RYOKU"
+    property bool locked: false
+    property bool animateFoil: false
+    property real foilPhase: 0
+    readonly property color tint: ({
+        common: "#9499a6",
+        uncommon: "#86bca6",
+        rare: "#65b9e1",
+        epic: "#c38be6",
+        legendary: "#f1bb6e",
+        mythic: "#f17854",
+        holographic: "#c5a8f6"
+    })[rarity] || "#9499a6"
+
+    implicitWidth: 150
+    implicitHeight: 150
+
+    SequentialAnimation on foilPhase {
+        running: seal.animateFoil && seal.rarity === "holographic" && !seal.locked
+        loops: Animation.Infinite
+        NumberAnimation { from: 0; to: 1; duration: 5500 }
+        NumberAnimation { from: 1; to: 0; duration: 5500 }
+    }
+
+    Canvas {
+        id: face
+        anchors.fill: parent
+        renderTarget: Canvas.Image
+        renderStrategy: Canvas.Threaded
+        antialiasing: true
+        onWidthChanged: requestPaint()
+        onHeightChanged: requestPaint()
+
+        function arcText(ctx, word, radius, angle, size, color, clockwise) {
+            var text = String(word || "").toUpperCase().slice(0, 23);
+            var advance = Math.min(0.16, Math.PI / Math.max(6, text.length + 2));
+            var start = angle - advance * (text.length - 1) * (clockwise ? 0.5 : -0.5);
+            ctx.font = "bold " + size + "px sans-serif";
+            ctx.fillStyle = color;
+            ctx.textAlign = "center";
+            ctx.textBaseline = "middle";
+            for (var i = 0; i < text.length; i++) {
+                ctx.save();
+                var t = start + advance * i * (clockwise ? 1 : -1);
+                ctx.rotate(t);
+                ctx.translate(0, -radius);
+                ctx.rotate(clockwise ? 0 : Math.PI);
+                ctx.fillText(text[i], 0, 0);
+                ctx.restore();
+            }
+        }
+
+        onPaint: {
+            var c = getContext("2d");
+            c.reset();
+            var scale = Math.min(width, height) / 200;
+            c.save();
+            c.translate(width / 2, height / 2);
+            c.scale(scale, scale);
+
+            var base = seal.locked ? "#111318" : "#17181d";
+            var ink = seal.locked ? "#535661" : seal.tint.toString();
+            if (seal.rarity === "holographic" && !seal.locked) {
+                var shine = c.createLinearGradient(-95, -95, 95, 95);
+                shine.addColorStop(0, "#73d4e1");
+                shine.addColorStop(Math.max(0.01, seal.foilPhase), "#eb94d9");
+                shine.addColorStop(1, "#e7bd7b");
+                ink = shine;
+            }
+
+            c.beginPath();
+            c.arc(0, 0, 95, 0, Math.PI * 2);
+            c.fillStyle = base;
+            c.fill();
+            c.lineWidth = 1.5;
+            c.strokeStyle = ink;
+            c.stroke();
+
+            c.beginPath();
+            c.arc(0, 0, 90, 0, Math.PI * 2);
+            c.lineWidth = 0.9;
+            c.strokeStyle = ink;
+            c.stroke();
+
+            for (var i = 0; i < 96; i++) {
+                var t = i * Math.PI / 48;
+                c.save();
+                c.rotate(t);
+                c.beginPath();
+                c.moveTo(0, -93);
+                c.lineTo(0, i % 8 === 0 ? -86 : i % 4 === 0 ? -89 : -91);
+                c.lineWidth = i % 8 === 0 ? 1.6 : 0.7;
+                c.strokeStyle = ink;
+                c.stroke();
+                c.restore();
+            }
+
+            c.beginPath();
+            c.arc(0, 0, 80, 0, Math.PI * 2);
+            c.lineWidth = 1;
+            c.strokeStyle = ink;
+            c.stroke();
+
+            c.beginPath();
+            c.arc(0, 0, 49, 0, Math.PI * 2);
+            c.lineWidth = 0.75;
+            c.strokeStyle = ink;
+            c.stroke();
+
+            if (["epic", "legendary", "mythic", "holographic"].indexOf(seal.rarity) >= 0) {
+                c.beginPath();
+                c.arc(0, 0, 76, Math.PI * 0.82, Math.PI * 1.18);
+                c.arc(0, 0, 76, Math.PI * 1.82, Math.PI * 2.18);
+                c.lineWidth = 2.2;
+                c.strokeStyle = ink;
+                c.stroke();
+                for (var ornament = 0; ornament < 16; ornament++) {
+                    c.save();
+                    c.rotate(ornament * Math.PI / 8);
+                    c.beginPath();
+                    c.moveTo(0, -83);
+                    c.lineTo(3, -81);
+                    c.lineTo(0, -79);
+                    c.lineTo(-3, -81);
+                    c.closePath();
+                    c.fillStyle = ink;
+                    c.fill();
+                    c.restore();
+                }
+            }
+            if (seal.rarity === "mythic" || seal.rarity === "holographic") {
+                c.beginPath();
+                c.arc(0, 0, 43, 0, Math.PI * 2);
+                c.lineWidth = 0.8;
+                c.strokeStyle = ink;
+                c.stroke();
+            }
+
+            for (var j = 0; j < 4; j++) {
+                c.save();
+                c.rotate(j * Math.PI / 2);
+                c.fillStyle = ink;
+                c.fillRect(-3, -55, 6, 6);
+                c.restore();
+            }
+
+            c.fillStyle = ink;
+            c.font = "bold 46px sans-serif";
+            c.textAlign = "center";
+            c.textBaseline = "middle";
+            c.fillText(seal.locked ? "?" : seal.sigil, 0, 2, 70);
+
+            c.fillStyle = ink;
+            c.font = "bold 9px monospace";
+            c.fillText("力", 0, -65);
+            arcText(c, seal.title, 66, -Math.PI / 2, 10, ink, true);
+            arcText(c, seal.category, 70, Math.PI / 2, 8, ink, false);
+
+            c.font = "7px monospace";
+            c.fillText(seal.rarity.toUpperCase(), 0, 72);
+            c.restore();
+        }
+    }
+
+    onTintChanged: face.requestPaint()
+    onTitleChanged: face.requestPaint()
+    onSigilChanged: face.requestPaint()
+    onRarityChanged: face.requestPaint()
+    onCategoryChanged: face.requestPaint()
+    onLockedChanged: face.requestPaint()
+    onFoilPhaseChanged: if (animateFoil) face.requestPaint()
+}
diff --git a/ryoku/hub/quickshell/components/about/BlackPrism.qml b/ryoku/hub/quickshell/components/about/BlackPrism.qml
new file mode 100644
index 00000000..0cf99df4
--- /dev/null
+++ b/ryoku/hub/quickshell/components/about/BlackPrism.qml
@@ -0,0 +1,169 @@
+import QtQuick
+import Lithic
+
+Item {
+    id: prism
+
+    property bool live: true
+    property real phase: 0
+    readonly property bool moving: live && visible && !Lithic.reduceMotion
+
+    clip: true
+    implicitWidth: 480
+    implicitHeight: 270
+
+    NumberAnimation on phase {
+        from: 0
+        to: 1
+        duration: 18000
+        loops: Animation.Infinite
+        running: prism.moving
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: "#080a11"
+    }
+
+    Canvas {
+        anchors.fill: parent
+        renderTarget: Canvas.Image
+        renderStrategy: Canvas.Threaded
+        antialiasing: true
+        onWidthChanged: requestPaint()
+        onHeightChanged: requestPaint()
+
+        onPaint: {
+            var c = getContext("2d");
+            c.reset();
+            var w = width, h = height;
+            var cx = w * 0.56, cy = h * 0.47;
+            c.fillStyle = "#080a11";
+            c.fillRect(0, 0, w, h);
+
+            var atmosphere = c.createRadialGradient(cx, cy, 12, cx, cy, Math.max(w, h) * 0.68);
+            atmosphere.addColorStop(0, "#25213a");
+            atmosphere.addColorStop(0.24, "#18192e");
+            atmosphere.addColorStop(0.55, "#10131f");
+            atmosphere.addColorStop(1, "#080a11");
+            c.fillStyle = atmosphere;
+            c.fillRect(0, 0, w, h);
+
+            c.save();
+            c.translate(cx, cy);
+            for (var r = 0; r < 6; r++) {
+                var scale = 42 + r * 43;
+                c.beginPath();
+                for (var i = 0; i < 8; i++) {
+                    var angle = Math.PI * 2 * i / 8 + Math.PI / 8;
+                    var x = Math.cos(angle) * scale;
+                    var y = Math.sin(angle) * scale;
+                    if (!i) c.moveTo(x, y);
+                    else c.lineTo(x, y);
+                }
+                c.closePath();
+                c.lineWidth = r % 2 ? 0.7 : 1.3;
+                c.strokeStyle = ["#55435d","#4e526c","#5d566c","#3e6175","#453b64","#273b50"][r];
+                c.stroke();
+            }
+            for (var j = 0; j < 24; j++) {
+                var a = j * Math.PI / 12;
+                c.beginPath();
+                c.moveTo(Math.cos(a) * 35, Math.sin(a) * 35);
+                c.lineTo(Math.cos(a) * 310, Math.sin(a) * 310);
+                c.strokeStyle = j % 3 ? "rgba(106,114,164,0.08)" : "rgba(198,142,132,0.18)";
+                c.lineWidth = j % 3 ? 0.6 : 1.1;
+                c.stroke();
+            }
+            c.restore();
+
+            for (var y = 0; y < h; y += 44) {
+                c.fillStyle = "rgba(221,219,240,0.017)";
+                c.fillRect(0, y, w, 1);
+            }
+            for (var x = 0; x < w; x += 44) {
+                c.fillStyle = "rgba(221,219,240,0.017)";
+                c.fillRect(x, 0, 1, h);
+            }
+
+            c.fillStyle = "rgba(208,186,209,0.26)";
+            c.font = "bold 11px monospace";
+            c.textBaseline = "middle";
+            c.fillText("力  /  BLACK PRISM", 24, h - 27);
+            c.fillStyle = "rgba(190,183,209,0.25)";
+            c.textAlign = "right";
+            c.fillText("ARCHIVE COMPLETE / 032", w - 24, h - 27);
+        }
+    }
+
+    Item {
+        id: lightWheel
+        width: Math.min(prism.width, prism.height) * 0.9
+        height: width
+        anchors.centerIn: parent
+        anchors.horizontalCenterOffset: prism.width * 0.06
+        opacity: 0.45
+
+        rotation: prism.moving ? prism.phase * 360 : 28
+
+        Repeater {
+            model: 8
+            delegate: Rectangle {
+                required property int index
+                width: lightWheel.width * 0.052
+                height: lightWheel.height * 0.48
+                x: lightWheel.width / 2 - width / 2
+                y: lightWheel.height / 2 - height
+                radius: width / 2
+                transformOrigin: Item.Bottom
+                rotation: index * 45
+                gradient: Gradient {
+                    GradientStop { position: 0; color: "#04070c" }
+                    GradientStop { position: 0.58; color: index % 3 === 0 ? "#80516d" : index % 3 === 1 ? "#4f718b" : "#8b665e" }
+                    GradientStop { position: 1; color: "#171724" }
+                }
+            }
+        }
+    }
+
+    Rectangle {
+        width: Math.max(46, Math.min(prism.width, prism.height) * 0.25)
+        height: width
+        anchors.centerIn: lightWheel
+        radius: width / 2
+        color: "#080910"
+        border.width: 2
+        border.color: "#7a708d"
+
+        Rectangle {
+            anchors.centerIn: parent
+            width: parent.width * 0.66
+            height: width
+            radius: width / 2
+            color: "#10101a"
+            border.width: 1
+            border.color: "#bb8079"
+        }
+    }
+
+    Rectangle {
+        width: prism.width * 0.07
+        height: prism.height * 1.7
+        x: -width + prism.phase * (prism.width + width * 4)
+        y: -prism.height * 0.27
+        rotation: 22
+        opacity: prism.moving ? 0.14 : 0
+        gradient: Gradient {
+            GradientStop { position: 0; color: "transparent" }
+            GradientStop { position: 0.48; color: "#b2a4df" }
+            GradientStop { position: 0.52; color: "#e2a5a9" }
+            GradientStop { position: 1; color: "transparent" }
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: "#080a11"
+        opacity: 0.22
+    }
+}
