+
+func TestProductEntryLicenseMetadata(t *testing.T) {
+	var entry ProductEntry
+	if err := json.Unmarshal([]byte(`{"id":"licensed","license":"GPL-3.0-only"}`), &entry); err != nil {
+		t.Fatal(err)
+	}
+	item, err := productEntryItem("", "barstyles", entry)
+	if err != nil || item.License != "GPL-3.0-only" {
+		t.Fatalf("license = %q, %v", item.License, err)
+	}
+	if err := json.Unmarshal([]byte(`{"id":"unlicensed"}`), &entry); err != nil || entry.License != "" {
+		t.Fatalf("missing license retained metadata: %#v, %v", entry, err)
+	}
+	for _, raw := range []string{
+		`{"license":42}`,
+		`{"license":"MIT","unexpected":true}`,
+	} {
+		if err := json.Unmarshal([]byte(raw), &entry); err == nil {
+			t.Fatalf("invalid metadata accepted: %s", raw)
+		}
+	}
+}
