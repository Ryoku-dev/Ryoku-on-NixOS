+func TestShellCatalogLeavesLegacyInstallsUntouched(t *testing.T) {
+	for _, category := range []string{"barstyles", "subshells"} {
+		t.Run(category, func(t *testing.T) {
+			f := newShellFixture(t)
+			f.addCatalogueItem(category, "obi", testShellManifest(), defaultShellFiles(), nil)
+			old := writeLegacyInstall(t, "obi")
+			f.writeConfig("shell.json", map[string]any{"barStyle": "obi"})
+
+			items, _, err := newShellItemProvider(category, f.cache()).Load(context.Background(), false)
+			if err != nil || len(items) == 0 {
+				t.Fatalf("catalogue = %#v, %v", items, err)
+			}
+			receipt, err := readReceipt("barstyles", "obi")
+			if err != nil || receipt.Shell != nil || receipt.Version != "0.9.0" {
+				t.Fatalf("catalogue migrated legacy receipt: %#v, %v", receipt, err)
+			}
+			if matches, err := destinationMatchesReceipt(old, receipt); err != nil || !matches {
+				t.Fatalf("catalogue changed legacy files: matches=%v, %v", matches, err)
+			}
+			if style := f.readConfig("shell.json")["barStyle"]; style != "obi" {
+				t.Fatalf("catalogue changed active bar: %v", style)
+			}
+		})
+	}
+}
