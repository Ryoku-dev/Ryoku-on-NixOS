@@ -143,0 +155,66 @@ pub fn harvest(cookies: Vec<(String, String, String)>) -> Option<SoundcloudAuth>
+
+/// Import a YouTube Music web session from the user's real browser.
+///
+/// Only youtube.com cookies are returned. The core still validates the resulting cookie against
+/// YouTube before persisting it, so stale browser sessions fail closed rather than becoming a
+/// half-authenticated Ryotunes account.
+pub fn import_youtube_any() -> Option<LoginResult> {
+    for store in discover() {
+        if !changed_since_last_look(&store.path, "youtube") {
+            continue;
+        }
+        let cookies = match store.kind {
+            Kind::Gecko => read_gecko_domain(&store.path, "youtube.com"),
+            Kind::Chromium => read_chromium_domain(&store.path, "youtube.com"),
+        };
+        let Some(cookies) = cookies else { continue };
+        let pairs = youtube_cookie_pairs(cookies);
+        let header =
+            pairs.iter().map(|(k, v)| format!("{k}={v}")).collect::<Vec<_>>().join("; ");
+        if innertube::cookie_sapisid(&header).is_some() {
+            tracing::info!(store = %store.path.display(), "imported a YouTube Music session from the browser");
+            return Some(LoginResult { cookies: pairs, authuser: 0 });
+        }
+    }
+    None
+}
+
+const YOUTUBE_AUTH_COOKIES: &[&str] = &[
+    "APISID",
+    "HSID",
+    "LOGIN_INFO",
+    "SAPISID",
+    "SID",
+    "SIDCC",
+    "SSID",
+    "__Secure-1PAPISID",
+    "__Secure-1PSID",
+    "__Secure-1PSIDCC",
+    "__Secure-1PSIDTS",
+    "__Secure-3PAPISID",
+    "__Secure-3PSID",
+    "__Secure-3PSIDCC",
+    "__Secure-3PSIDTS",
+];
+
+fn youtube_cookie_pairs(cookies: Vec<(String, String, String)>) -> Vec<(String, String)> {
+    let mut cookies: Vec<(String, String, String)> = cookies
+        .into_iter()
+        .filter(|(name, _, _)| YOUTUBE_AUTH_COOKIES.contains(&name.as_str()))
+        .map(|(name, value, domain)| {
+            let domain = domain.strip_prefix('.').map(str::to_owned).unwrap_or(domain);
+            (name, value, domain)
+        })
+        .collect();
+    // Browser precedence: a more-specific music.youtube.com cookie wins over a broad
+    // .youtube.com cookie with the same name.
+    cookies.sort_by_key(|(_, _, domain)| domain.len());
+    let mut jar = BTreeMap::new();
+    for (name, value, domain) in cookies {
+        if domain == "youtube.com" || domain.ends_with(".youtube.com") {
+            jar.insert(name, value);
+        }
+    }
+    jar.into_iter().collect()
+}
+
@@ -321,0 +399,43 @@ fn read_chromium(path: &Path) -> Option<Vec<(String, String, String)>> {
+
+fn read_gecko_domain(path: &Path, domain: &str) -> Option<Vec<(String, String, String)>> {
+    let (_dir, connection) = copy_and_open(path)?;
+    let pattern = format!("%{domain}");
+    let mut statement = connection
+        .prepare("SELECT name, value, host FROM moz_cookies WHERE host LIKE ?1")
+        .ok()?;
+    let rows = statement
+        .query_map(rusqlite::params![pattern], |row| {
+            Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?, row.get::<_, String>(2)?))
+        })
+        .ok()?;
+    Some(rows.flatten().collect())
+}
+
+fn read_chromium_domain(path: &Path, domain: &str) -> Option<Vec<(String, String, String)>> {
+    let (_dir, connection) = copy_and_open(path)?;
+    let pattern = format!("%{domain}");
+    let mut statement = connection
+        .prepare(
+            "SELECT name, host_key, encrypted_value, value FROM cookies WHERE host_key LIKE ?1",
+        )
+        .ok()?;
+    let rows = statement
+        .query_map(rusqlite::params![pattern], |row| {
+            Ok((
+                row.get::<_, String>(0)?,
+                row.get::<_, String>(1)?,
+                row.get::<_, Vec<u8>>(2)?,
+                row.get::<_, Vec<u8>>(3)?,
+            ))
+        })
+        .ok()?;
+    let mut out = Vec::new();
+    for row in rows.flatten() {
+        let (name, host, encrypted, plain) = row;
+        if let Some(value) = chromium_value(&encrypted, &plain, &host) {
+            out.push((name, value, host));
+        }
+    }
+    Some(out)
+}
+
