# Maintainer: Ryoku <releases@ryoku.dev>
#
# Vendored from the AUR (gitlab.com/Zesko/limine-snapper-sync) into [ryoku] so it
# ships in the signed repo and installs offline alongside limine-mkinitcpio-hook.
# It hangs the Snapshots submenu under the Ryoku boot entry (matching
# TARGET_OS_NAME in /etc/default/limine), so btrfs rollbacks appear at boot. As
# an AUR-only package it was skipped on offline installs, leaving those boxes
# with no boot-menu rollback; base.packages now pacstraps it.
pkgname="limine-snapper-sync"
pkgver=1.32.1
pkgrel=1
pkgdesc="Integrates Limine boot entries with Snapper snapshots."
arch=('x86_64')
url="https://gitlab.com/Zesko/limine-snapper-sync"
# Gradle is vendored for the same reason as limine-mkinitcpio-hook: Arch's 9.7.0
# stopped resolving the gradle-public-api-legacy module the graalvm buildtools
# plugin wanted, which failed nativeCompile and blocked every user update. Both
# halves of the Limine stack pin the same version, so bump them together.
# The graalvm buildtools plugin is vendored in release/gradle-offline/repo
# (shared with limine-mkinitcpio-hook, same pinned version) and resolved from
# there first, so a plugin-portal outage cannot fail the publish gate. Compile
# deps and the reachability-metadata zip are still fetched upstream. gettext is
# for msgfmt: since 1.32 the build compiles the po/ catalogues into the tree.
_gradleoffline="$startdir/../../gradle-offline"
_gradlever=9.6.1
source=("${pkgname}::git+${url}.git#tag=${pkgver}"
	"https://services.gradle.org/distributions/gradle-${_gradlever}-bin.zip")
source_x86_64=("https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.2.4/graalvm-community-jdk-25i2-25.0.4_linux-x64_bin.tar.gz")
license=("GPL3")
options=(!debug !strip)
_graalvm_version=graalvm_ce_jdk25
depends=(
	'bash'
	'limine'
	'snapper'
	'btrfs-progs'
	'libnotify')
optdepends=(
	'limine-mkinitcpio-hook: Automates kernel installation/removal and Limine boot entry management.'
	'limine-dracut-support: Automates kernel installation/removal and Limine boot entry management.'
	'inotify-tools: Monitors when snapshots are created or deleted.'
	'rsync: Alternative method for restoring snapshots.'
	'b3sum: Fast Blake3 hash function to prevent duplication.'
	'xxhash: Fast hashing utility for deduplication with shorter hashes.'
)
makedepends=('git' 'gettext')
backup=(etc/limine-snapper-sync.conf)
conflicts=('limine-snapper-cli' 'limine-snapper-sync-git')
sha256sums=('c2a8a9618fc481e036fbfeb2016b2991c593abbcea871c13adc1af5d23eb2337'
	'9c0f7faeeb306cb14e4279a3e084ca6b596894089a0638e68a07c945a32c9e14')
sha256sums_x86_64=('3f4a89de8eaa96f2ed677f09957c7e872cd8467aad3537f8b5394c1b8c4b942e')

prepare() {
	[[ -d "${_graalvm_version}" ]] && rm -rf "${_graalvm_version}"
	mv graalvm-community-*/ "${_graalvm_version}"
	if ! command -v "${_graalvm_version}"/bin/javac >/dev/null 2>&1; then
		echo "Error: ${_graalvm_version}/bin/javac not found." >&2
		return 1
	fi
}

build() {
	cd "$srcdir/${pkgname}"
	export GRAALVM_HOME="$srcdir/${_graalvm_version}"
	export JAVA_HOME="${GRAALVM_HOME}"
	export NATIVE_IMAGE_OPTIONS="-march=compatibility"
	"$srcdir/gradle-${_gradlever}/bin/gradle" clean nativeCompile \
		-I "$_gradleoffline/offline.init.gradle" \
		-Dryoku.offline.repo="file://$_gradleoffline/repo" \
		-Dorg.gradle.java.home="${JAVA_HOME}"
}

package() {
	cd "$srcdir/${pkgname}"
	local src="install/arch-linux"

	install -dm 755 \
		"$pkgdir/usr/share/doc/limine-snapper-sync" \
		"$pkgdir/etc/boot/hooks/pre.d" \
		"$pkgdir/etc/boot/hooks/post.d" \
		"$pkgdir/usr/lib/limine"

	install -Dm 644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/limine-snapper-sync/"

	cp -a "$src/etc" "$src/usr" "$pkgdir/"
	install -Dm 755 "build/native/nativeCompile/limine-snapper-sync" "$pkgdir/usr/lib/limine/"
}
