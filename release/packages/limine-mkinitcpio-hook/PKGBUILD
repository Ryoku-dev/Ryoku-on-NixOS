# Maintainer: Ryoku <releases@ryoku.dev>
#
# Vendored from the AUR (gitlab.com/Zesko/limine-entry-tool) into [ryoku] so the
# Limine boot stack ships in the signed repo and installs offline. The AUR build
# is skipped on offline installs and best-effort online, so a fresh box could
# boot with a frozen flat menu: no other-OS detection (FIND_BOOTLOADERS), no UKI
# tree, no Snapshots submenu. base.packages now pacstraps it. This package
# bundles limine-entry-tool (provides/conflicts it), so it is the whole tool plus
# the mkinitcpio hook that regenerates the menu on kernel changes.
_pkgname="limine-entry-tool"
pkgname="limine-mkinitcpio-hook"
_pkgver=1.40.0
pkgver="${_pkgver}"
pkgrel=1
pkgdesc="Install kernels for the Limine bootloader."
arch=('x86_64')
url="https://gitlab.com/Zesko/limine-entry-tool"
# Gradle is vendored, not taken from the distro. Arch shipped 9.7.0 on
# 2026-08-14 and it no longer resolved the gradle-public-api-legacy module the
# graalvm buildtools plugin of the day (1.1.3) asked for, so nativeCompile died
# in configuration and the publish gate blocked every user update. 9.6.1 is the
# version that last built green; pinning it beside the GraalVM tarball keeps the
# toolchain hermetic, so the next distro gradle bump cannot break the boot stack
# again.
#
# The plugin itself is vendored too, in release/gradle-offline/repo (12 files,
# 380K, shared with limine-snapper-sync which pins the same version, 1.1.14 since
# 1.40.0): Gradle resolved it from the plugin portal at build time, which is
# neither pinned nor checksummed, and a portal hiccup failed the publish gate
# with "Plugin [id: 'org.graalvm.buildtools.native'] was not found".
# offline.init.gradle puts that local repo FIRST so the portal is no longer on
# the critical path. It is not yet exclusive: the compile deps (jackson) and the
# plugin's reachability-metadata zip are still fetched, so the upstream repos
# stay as a fallback. Vendor those and this can drop to --offline.
# Regenerate with release/gradle-offline/refresh.sh <version> when upstream
# bumps it.
_gradleoffline="$startdir/../../gradle-offline"
_gradlever=9.6.1
source=("${_pkgname}::git+${url}.git#tag=${pkgver}"
	"https://services.gradle.org/distributions/gradle-${_gradlever}-bin.zip")
source_x86_64=("https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.2.4/graalvm-community-jdk-25i2-25.0.4_linux-x64_bin.tar.gz")
license=("GPL3")
provides=('limine-entry-tool')
options=(!debug !strip)
_graalvm_version=graalvm_ce_jdk25
depends=(
	'bash'
	'grep'
	'tar'
	'limine'
	'mkinitcpio'
	'efibootmgr')
optdepends=(
	'kernel-modules-hook: Safely keeps kernel on upgrade failure'
	'sbctl: Signs UEFI boot files for Secure Boot when enabled'
	'journalctl-desktop-notification: Sends desktop notifications when errors occur'
)
makedepends=('git')
backup=(etc/limine-entry-tool.conf)
conflicts=('limine-entry-tool')
sha256sums=('267e0496d863b01903d6b99dae8c222a0ec33c4108a8a5d6e9b38eaa4a4a2edf'
	'9c0f7faeeb306cb14e4279a3e084ca6b596894089a0638e68a07c945a32c9e14')
sha256sums_x86_64=('3f4a89de8eaa96f2ed677f09957c7e872cd8467aad3537f8b5394c1b8c4b942e')

prepare() {
	[[ -d "${_graalvm_version}" ]] && rm -rf "${_graalvm_version}"
	mv graalvm-community-*/ "${_graalvm_version}"
	if ! command -v "${_graalvm_version}"/bin/javac >/dev/null 2>&1; then
		echo "Error: ${_graalvm_version}/bin/javac not found." >&2
		return 1
	fi
}

build() {
	cd "$srcdir/${_pkgname}"
	export GRAALVM_HOME="$srcdir/${_graalvm_version}"
	export JAVA_HOME="${GRAALVM_HOME}"
	export NATIVE_IMAGE_OPTIONS="-march=compatibility --future-defaults=all"
	"$srcdir/gradle-${_gradlever}/bin/gradle" clean nativeCompile \
		-I "$_gradleoffline/offline.init.gradle" \
		-Dryoku.offline.repo="file://$_gradleoffline/repo" \
		-Dorg.gradle.java.home="${JAVA_HOME}"
}

package() {
	cd "$srcdir/${_pkgname}"
	local src="install/arch-linux"

	install -dm 755 \
		"$pkgdir/usr/share/doc/limine-entry-tool" \
		"$pkgdir/etc/boot/hooks/pre.d" \
		"$pkgdir/etc/boot/hooks/post.d" \
		"$pkgdir/usr/lib/limine"

	install -Dm 644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/limine-entry-tool/"

	cp -a "$src/limine-entry-tool/etc" "$src/limine-entry-tool/usr" "$pkgdir/"
	cp -a "$src/limine-mkinitcpio-hook/etc" "$src/limine-mkinitcpio-hook/usr" "$pkgdir/"
	install -Dm 755 "build/native/nativeCompile/limine-entry-tool" "$pkgdir/usr/lib/limine/"

	ln -sf /usr/bin/limine-reset-enroll "$pkgdir/etc/boot/hooks/pre.d/10-limine-reset-enroll"
	ln -sf /usr/bin/limine-enroll-config "$pkgdir/etc/boot/hooks/post.d/90-limine-enroll-config"
}
