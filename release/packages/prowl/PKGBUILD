# Maintainer: Ryoku <releases@ryoku.dev>
#
# Prowl is an external model gateway and code index that Rashin hosts; it plugs
# into the agent harnesses on the machine. This package builds a pinned upstream commit
# so every Ryoku release has one known version. The managedBy=pacman stamp keeps
# `prowl update` from replacing a pacman-owned binary.
# The minishlab potion-code-16M embedding model is compiled into the binary, so
# indexing never downloads a model at runtime.
pkgname=prowl
pkgver=0.17.2
pkgrel=2
pkgdesc="Prowl model gateway and code intelligence for Ryoku Rashin"
arch=('x86_64')
url="https://github.com/neur0map/prowl"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('go' 'git' 'gcc')
# replaces= without conflicts=: the two share no files, and pacman honours
# replaces only on a sysupgrade. `ryoku update` moves the Ryoku set with an
# explicit -S, which pulls prowl in through ryoku-rashin, and with a conflict
# that transaction failed on every box still carrying prowl-agent: --noconfirm
# answers the removal question No, and the CLI already installed is the one
# running it. The old agent now stays beside prowl until a -Syu swaps it or the
# user removes it; the manifest step reports it retired.
replaces=('prowl-agent')
options=('!lto' '!debug')
_commit=5ba05eb922ff023e3cbc2b9a3768829179bca980
source=("git+https://github.com/neur0map/prowl.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  export CGO_ENABLED=1
  export GOPATH="$srcdir/gopath"
  export GOCACHE="$srcdir/gocache"
  export GOFLAGS="-mod=mod"
  mkdir -p "$srcdir/out"
  go build -trimpath -tags sqlite_fts5 \
    -ldflags "-s -w -X main.version=v$pkgver -X main.commit=$_commit -X main.managedBy=pacman" \
    -o "$srcdir/out/prowl" ./cmd/prowl
}

package() {
  install -Dm755 "$srcdir/out/prowl" "$pkgdir/usr/bin/prowl"
  install -Dm644 "$srcdir/$pkgname/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$pkgname/NOTICE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
}
