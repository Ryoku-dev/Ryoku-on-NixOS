# shellcheck shell=bash
_reconcile_services() {
  command -v ryoku-host >/dev/null 2>&1 || return 0
  RYOKU_HOST_INIT=systemd ryoku-host svc reconcile --system >/dev/null 2>&1 || true
}

post_install() {
  _reconcile_services
}

post_upgrade() {
  _reconcile_services
}

post_remove() {
  systemctl --global disable ryoku-rashin.service ryoku-ai-usage.timer >/dev/null 2>&1 || true
}
