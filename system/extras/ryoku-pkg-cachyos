#!/usr/bin/env bash

# Add the CachyOS v3 and baseline repositories below every Arch repository and
# [ryoku]. Pacman keeps the first repository serving a package authoritative,
# so Arch userland stays Arch while CachyOS-only kernels, tuning, and gaming
# packages remain available. The stock kernel stays as the boot fallback.
# The full CachyOS install uses installation/backend/lib/cachyos.sh instead.

set -euo pipefail

manager=$(ryoku-host pkgmgr 2>/dev/null || true)
if [[ -n $manager && $manager != pacman ]]; then
  echo "ryoku-pkg-cachyos: the CachyOS repository is available only on pacman hosts (this host uses ${manager:-an unknown manager})" >&2
  exit 5
fi

conf=${RYOKU_PKG_CACHYOS_CONF:-/etc/pacman.conf}
privilege_command=${RYOKU_PRIVILEGE_COMMAND-sudo}
ld_linux=${RYOKU_LD_LINUX:-/lib/ld-linux-x86-64.so.2}
key=F3B607488DB35A47
fingerprint=882DCFE48E2051D48E2562ABF3B607488DB35A47
mirror=https://mirror.cachyos.org/repo

privileged() {
  if [[ -n $privilege_command ]]; then
    "$privilege_command" "$@"
  else
    "$@"
  fi
}

trust_key_from_keyring_package() (
  set -e
  local tmp member filename sha package keyring found=
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  curl --proto '=https' --tlsv1.2 -fsSL \
    "$mirror/x86_64/cachyos/cachyos.db" -o "$tmp/cachyos.db"
  while IFS= read -r member; do
    case $member in
      cachyos-keyring-*/desc) break ;;
      *) member= ;;
    esac
  done < <(bsdtar -tf "$tmp/cachyos.db")
  [[ -n $member ]]

  filename=$(bsdtar -xOf "$tmp/cachyos.db" "$member" |
    awk '$0 == "%FILENAME%" { getline; print; exit }')
  sha=$(bsdtar -xOf "$tmp/cachyos.db" "$member" |
    awk '$0 == "%SHA256SUM%" { getline; print; exit }')
  [[ -n $filename && -n $sha ]]

  package="$tmp/$filename"
  curl --proto '=https' --tlsv1.2 -fsSL \
    "$mirror/x86_64/cachyos/$filename" -o "$package"
  printf '%s  %s\n' "$sha" "$package" | sha256sum -c - >/dev/null

  keyring="$tmp/cachyos.gpg"
  bsdtar -xOf "$package" usr/share/pacman/keyrings/cachyos.gpg >"$keyring"
  mkdir -m 700 "$tmp/gnupg"
  while IFS=: read -r kind _ _ _ _ _ _ _ _ got _; do
    [[ $kind == fpr && $got == "$fingerprint" ]] && found=1
  done < <(GNUPGHOME="$tmp/gnupg" gpg --batch --with-colons --show-keys "$keyring")
  [[ $found == 1 ]]

  privileged pacman-key --add "$keyring"
  privileged pacman-key --lsign-key "$fingerprint"
)

# Serialize pacman.conf and keyring mutation. Two bundle installs can otherwise
# race and duplicate the repository stanzas.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ryoku-pkg-conf.lock"
flock 9

if ! "$ld_linux" --help 2>/dev/null | grep -q 'x86-64-v3 (supported'; then
  echo "ryoku-pkg-cachyos: this CPU does not support x86-64-v3; the CachyOS kernel needs it" >&2
  exit 1
fi

# A CachyOS edition or an already-fixed Arch box already has the baseline
# repository. Its native repository ordering and architecture policy are left
# byte-for-byte untouched.
if grep -qE '^\[cachyos\][[:space:]]*$' "$conf"; then
  echo "cachyos: repository already configured"
  exit 0
fi

echo "==> Trusting the CachyOS signing key"
if {
  privileged pacman-key --recv-keys "$key" --keyserver keyserver.ubuntu.com ||
    privileged pacman-key --recv-keys "$key" --keyserver hkps://keys.openpgp.org
} && privileged pacman-key --finger "$fingerprint" >/dev/null; then
  privileged pacman-key --lsign-key "$fingerprint"
else
  echo "==> Keyserver unavailable; importing the pinned key from cachyos-keyring"
  trust_key_from_keyring_package || {
    echo "ryoku-pkg-cachyos: could not establish trust in the CachyOS signing key" >&2
    exit 1
  }
fi

echo "==> Adding [cachyos-v3] and [cachyos] after the Arch repositories"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
has_architecture=0
grep -qE '^Architecture[[:space:]]*=' "$conf" && has_architecture=1
awk -v has_architecture="$has_architecture" '
  $0 == "[cachyos-v3]" { skip = 1; next }
  skip && /^\[[^]]+\][[:space:]]*$/ { skip = 0 }
  skip { next }
  /^Architecture[[:space:]]*=/ {
    if ($0 !~ /(^|[[:space:]])x86_64_v3([[:space:]]|$)/) $0 = $0 " x86_64_v3"
    print
    next
  }
  $0 == "[options]" && !has_architecture {
    print
    print "Architecture = auto x86_64_v3"
    next
  }
  { print }
' "$conf" >"$tmp"
cat >>"$tmp" <<EOF

[cachyos-v3]
Server = $mirror/x86_64_v3/cachyos-v3

[cachyos]
Server = $mirror/x86_64/cachyos
EOF
privileged cp "$tmp" "$conf"

grep -qE '^Architecture[[:space:]]*=.*x86_64_v3' "$conf" || {
  echo "ryoku-pkg-cachyos: could not enable x86_64_v3 in $conf" >&2
  exit 1
}
[[ $(grep -cE '^\[cachyos-v3\][[:space:]]*$' "$conf") -eq 1 ]] &&
  [[ $(grep -cE '^\[cachyos\][[:space:]]*$' "$conf") -eq 1 ]] || {
  echo "ryoku-pkg-cachyos: could not add the CachyOS repositories to $conf" >&2
  exit 1
}

echo "==> Synchronizing package databases"
privileged pacman -Sy
privileged pacman -S --needed --noconfirm cachyos-keyring
