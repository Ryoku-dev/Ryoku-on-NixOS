[Unit]
# Work around the BlueZ 5.83+ A2DP-disconnect regression (bluez#1545, #1646): a
# device connects, streams for ~1s, then drops, and stays broken until the
# bluetooth service is restarted. The restart is only reliable once the session
# audio stack (WirePlumber, which registers BlueZ's media endpoints) is up, so
# this is a user-session unit ordered after it -- a system unit cannot wait for a
# per-user service. Restarting with nothing connected yet (login, before the
# user reaches for headphones) clears the race with no audible drop.
Description=Reset the Bluetooth controller once the session audio stack is up (BlueZ A2DP-drop workaround)
PartOf=ryoku-session.target
After=ryoku-session.target wireplumber.service
# Skip the whole thing on a box with no Bluetooth radio.
ConditionPathExistsGlob=/sys/class/bluetooth/*

[Service]
Type=oneshot
# The helper restores the user's saved radio state after the restart. This keeps
# BlueZ's AutoEnable default for a new install without overriding a later off
# choice.
ExecStart=/usr/bin/ryoku-bluetooth-reset
TimeoutStartSec=30

[Install]
WantedBy=ryoku-session.target
