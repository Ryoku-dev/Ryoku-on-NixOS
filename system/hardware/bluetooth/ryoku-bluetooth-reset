#!/usr/bin/env bash
set -u

systemd_runtime="${RYOKU_SYSTEMD_RUNTIME:-/run/systemd/system}"
power_helper="${RYOKU_BLUETOOTH_POWER_BIN:-ryoku-bluetooth-power}"
restart_status=0
restore_status=0

if [[ -d $systemd_runtime ]]; then
  systemctl restart bluetooth.service || restart_status=$?
elif command -v timeout >/dev/null 2>&1; then
  timeout 30 sv restart bluetoothd || restart_status=$?
else
  sv restart bluetoothd || restart_status=$?
fi

"$power_helper" restore || restore_status=$?

if ((restart_status != 0)); then
  exit "$restart_status"
fi
exit "$restore_status"
